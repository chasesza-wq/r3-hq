function demoUrl(l){
  const d=rec(l,true);
  if(d && d.demoUrl) return d.demoUrl;              // one built + pasted back in
  const path=DEMO_PATHS[l.category]; if(!path) return null;
  const q=new URLSearchParams({name:l.business_name||"",phone:l.phone||"",city:l.city||"",
    rating:l.rating??"",reviews:l.review_count??""});
  return DEMO_BASE+path+"/?"+q.toString();
}
function buildCmd(l){
  const tpl=DEMO_BUILDABLE[l.category]||"detailing";
  const slug=(l.business_name||"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,40);
  return `cd ~/claude/agency/clients && printf '%s\\n' `+
    `"BUSINESS_NAME=${(l.business_name||"").replace(/"/g,"")}" "CITY=${l.city||""}" `+
    `"PHONE=${fmtPhone(l.phone)}" "RATING=${l.rating??""}" "REVIEW_COUNT=${l.review_count??""}" `+
    `> /tmp/${slug}.env && ./build_site.sh ${tpl} ~/claude/r3-deploy/${slug}/index.html /tmp/${slug}.env`;
}

