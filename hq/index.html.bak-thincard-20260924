<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>RecoverRevenue — Sales HQ</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='15' fill='%2311141a'/%3E%3Cpath d='M20 45V19h9.6a6.7 6.7 0 0 1 0 13.4H20m8.4 0L35 45' stroke='%234fc2b4' stroke-width='5.4' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3Cpath d='M38 19h6.6a5.8 5.8 0 0 1 0 11.6h-2.4 2.4a6.4 6.4 0 0 1 0 12.8H38' stroke='%234fc2b4' stroke-width='5.4' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="../assets/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Sales HQ">
<meta name="theme-color" content="#11141a">
<style>
  :root{
    --bg:#ffffff; --bg2:#f4f5f7; --bg3:#eceef1; --ink:#11141a; --dim:#767c88;
    --line:rgba(17,20,26,.09); --green:#12a065; --amber:#c77800; --blue:#15427d;
    --red:#c8321f; --teal:#0f8d84; --sheet:#ffffff; --pill:#11141a; --pill-ink:#ffffff;
    --shadow:0 1px 2px rgba(17,20,26,.05),0 8px 24px rgba(17,20,26,.07);
  }
  [data-theme="dark"]{
    --bg:#0e1013; --bg2:#181b20; --bg3:#22262c; --ink:#f2f4f6; --dim:#8b919c;
    --line:rgba(242,244,246,.10); --sheet:#181b20; --pill:#f2f4f6; --pill-ink:#0e1013;
    --blue:#6a9de0; --red:#f0705c; --green:#31c184; --amber:#e0a03a; --teal:#4fc2b4;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.45);
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overscroll-behavior:none}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Inter","Segoe UI",sans-serif;
    background:#dfe2e6; display:flex; align-items:center; justify-content:center;
    min-height:100vh; padding:24px; -webkit-font-smoothing:antialiased; color:var(--ink);
  }
  [data-theme="dark"] body{background:#000}
  button{font-family:inherit;cursor:pointer;color:inherit;border:none;background:none}
  a{color:inherit;text-decoration:none}
  input,select{font-family:inherit;color:inherit}

  .device{
    width:100%; max-width:420px; height:860px; max-height:calc(100vh - 48px);
    background:var(--bg); border-radius:46px; overflow:hidden; position:relative;
    box-shadow:0 30px 80px rgba(0,0,0,.30), 0 0 0 10px #16181c, 0 0 0 12px #3c3e42;
    display:flex; flex-direction:column;
  }
  @media (max-width:560px){
    body{padding:0;background:var(--bg)}
    .device{max-width:none;height:100vh;height:100dvh;max-height:none;border-radius:0;box-shadow:none}
  }

  /* ── header ───────────────────────────────────────────── */
  header{padding:20px 20px 10px;display:flex;align-items:center;gap:12px;flex-shrink:0}
  .mark{width:30px;height:30px;border-radius:9px;flex-shrink:0;color:var(--ink)}
  .qbtn{
    flex:1;min-width:0;display:flex;align-items:center;gap:9px;padding:9px 12px;
    border-radius:13px;background:var(--bg2);border:1px solid var(--line);text-align:left;
  }
  .qbtn:active{background:var(--bg3)}
  .qbtn .qi{width:15px;height:15px;flex-shrink:0;stroke:var(--teal);stroke-width:2;fill:none}
  .qbtn .qt{flex:1;min-width:0;display:flex;flex-direction:column}
  .qbtn .q1{display:block;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);font-weight:700}
  .qbtn .q2{font-size:13.5px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
  .qbtn .qn{font-size:12px;font-weight:700;color:var(--dim);font-variant-numeric:tabular-nums;flex-shrink:0}
  .avatar{
    width:34px;height:34px;border-radius:50%;background:var(--bg2);border:1px solid var(--line);
    font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }

  main{flex:1;overflow-y:auto;padding:0 20px 108px;scrollbar-width:none;position:relative}
  main::-webkit-scrollbar{display:none}
  .screen{display:none}
  .screen.active{display:block}
  h1{font-size:25px;font-weight:700;letter-spacing:-.025em;margin:10px 0 3px}
  .sub{font-size:13px;color:var(--dim);margin-bottom:16px;line-height:1.45}
  .empty{padding:44px 20px;text-align:center;color:var(--dim);font-size:13.5px;line-height:1.6;
    background:var(--bg2);border-radius:16px;margin-top:12px}

  /* ── the deck ─────────────────────────────────────────── */
  .deckwrap{position:relative;padding-top:6px;touch-action:pan-y}
  .deckbar{display:flex;align-items:center;gap:8px;margin:2px 0 10px;font-size:11px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--dim);font-weight:700}
  .deckbar .prog{flex:1;height:3px;border-radius:2px;background:var(--bg3);overflow:hidden}
  .deckbar .prog i{display:block;height:100%;background:var(--teal);border-radius:2px;transition:width .3s}
  .card{
    background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:16px 17px 17px;
    box-shadow:var(--shadow);will-change:transform;position:relative;
  }
  .card.snap{transition:transform .26s cubic-bezier(.22,1,.36,1)}
  .hint{
    position:absolute;top:16px;padding:5px 11px;border-radius:9px;font-size:11px;font-weight:800;
    letter-spacing:.1em;text-transform:uppercase;opacity:0;pointer-events:none;transition:opacity .1s;
  }
  .hint.l{left:14px;background:var(--bg3);color:var(--dim)}
  .hint.r{right:14px;background:var(--teal);color:#fff}

  .vbadge{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:7px;
    font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .vbadge.ok{background:rgba(18,160,101,.12);color:var(--green)}
  .vbadge.check{background:rgba(199,120,0,.13);color:var(--amber)}
  .vbadge .dot{width:5px;height:5px;border-radius:50%;background:currentColor}
  .warn{margin-top:12px;background:rgba(199,120,0,.09);border-left:3px solid var(--amber);
    border-radius:0 10px 10px 0;padding:10px 12px;font-size:12.5px;line-height:1.5;color:var(--ink)}
  .warn b{color:var(--amber)}
  .cardtop{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .intake{display:flex;flex-direction:column;align-items:flex-end;font-size:15px;font-weight:750;
    letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
  .intake i{font-style:normal;font-size:9px;letter-spacing:.13em;text-transform:uppercase;
    color:var(--dim);font-weight:700;margin-top:2px}
  .asks{margin-top:13px;padding:13px 14px;background:var(--bg2);border-radius:13px}
  .asks .ol{font-size:9.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--teal);
    font-weight:750;margin-bottom:8px}
  .asks ol{margin:0;padding-left:17px}
  .asks li{font-size:13.5px;line-height:1.42;font-weight:500;margin-bottom:7px}
  .asks li:last-child{margin-bottom:0}
  .asks li::marker{color:var(--dim);font-weight:700;font-size:11px}
  /* The numbers do the arguing. Three sourced figures, nothing estimated. */
  .numstrip{display:flex;gap:7px;margin-top:12px}
  .numstrip div{flex:1;background:var(--bg2);border-radius:12px;padding:10px 9px;text-align:center}
  .numstrip b{display:block;font-size:19px;font-weight:800;letter-spacing:-.02em;line-height:1.1}
  .numstrip i{display:block;font-style:normal;font-size:8.5px;letter-spacing:.13em;
    text-transform:uppercase;color:var(--dim);font-weight:750;margin-top:4px}
  .numstrip .good b{color:var(--green)}
  /* One question. Not a discovery script — the thing you say after they say hello. */
  .theask{margin-top:12px;padding:15px 15px 13px;background:var(--bg2);border-radius:13px;
    border-left:3px solid var(--teal)}
  .theask .ol{font-size:9.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--teal);
    font-weight:750;margin-bottom:9px}
  .theask q{display:block;font-size:16.5px;line-height:1.38;font-weight:650;quotes:'"' '"'}
  .theask .then{margin-top:11px;padding-top:10px;border-top:1px solid var(--line);
    font-size:13px;line-height:1.4;color:var(--dim);font-weight:550}
  .theask .then b{color:var(--fg);font-weight:700}
  /* ── LIST MODE. Every number on one screen. Chase asked for the sheet of numbers
     back: scan it, tap one, see who they are and the two ways to open. */
  .modesw{display:flex;gap:4px;background:var(--bg3);border-radius:9px;padding:3px}
  .modesw button{border:0;background:none;color:var(--dim);font:inherit;font-size:10px;
    font-weight:750;letter-spacing:.08em;text-transform:uppercase;padding:5px 11px;
    border-radius:7px;cursor:pointer}
  .modesw button.on{background:var(--bg);color:var(--fg);box-shadow:var(--shadow)}
  .lrow{background:var(--bg);border:1px solid var(--line);border-radius:15px;margin-bottom:7px;
    overflow:hidden}
  .lrow.done{opacity:.45}
  .lhead{display:flex;align-items:center;gap:11px;padding:12px 13px;cursor:pointer}
  .lhead .lnum{font-size:19px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .lhead .lbiz{flex:1;min-width:0}
  .lhead .lbiz b{display:block;font-size:13px;font-weight:700;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .lhead .lbiz span{display:block;font-size:11px;color:var(--dim);margin-top:2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lpay{font-size:11px;font-weight:800;color:var(--green);white-space:nowrap}
  .lbody{padding:0 13px 13px;border-top:1px solid var(--line)}
  .lfact{font-size:12.5px;line-height:1.5;margin-top:10px}
  .lfact b{color:var(--dim);font-weight:700;font-size:10px;letter-spacing:.1em;
    text-transform:uppercase;display:block;margin-bottom:2px}
  .lopen{display:block;width:100%;text-align:left;margin-top:9px;padding:11px 12px;
    background:var(--bg2);border:1px solid var(--line);border-left:3px solid var(--teal);
    border-radius:11px;color:inherit;font:inherit;cursor:pointer}
  .lopen i{display:block;font-style:normal;font-size:9.5px;letter-spacing:.13em;
    text-transform:uppercase;color:var(--teal);font-weight:750;margin-bottom:5px}
  .lopen q{display:block;font-size:14px;line-height:1.4;font-weight:600;quotes:'"' '"'}
  .lacts{display:flex;gap:7px;margin-top:11px}
  .lacts a,.lacts button{flex:1;text-align:center;padding:12px;border-radius:12px;border:0;
    font:inherit;font-size:12.5px;font-weight:750;cursor:pointer}
  .lacts .lcall{background:var(--teal);color:#fff}
  .lacts .lcard{background:var(--bg2);color:var(--dim)}
  .altcall{display:block;text-align:center;margin-top:7px;padding:10px;border-radius:12px;
    background:var(--bg2);font-size:12.5px;font-weight:650;color:var(--dim)}
  details.meta{margin-top:11px}
  details.meta summary{list-style:none;font-size:11px;font-weight:700;color:var(--dim);
    letter-spacing:.05em;cursor:pointer;display:flex;align-items:center;gap:6px}
  details.meta summary::-webkit-details-marker{display:none}
  details.meta summary::before{content:"›";font-size:14px;transition:transform .2s;display:inline-block}
  details.meta[open] summary::before{transform:rotate(90deg)}
  details.meta p{font-size:13.5px;line-height:1.5;margin-top:9px;padding:11px 13px;
    background:var(--bg2);border-radius:11px}
  .cname{font-size:26px;font-weight:750;letter-spacing:-.03em;line-height:1.1;margin:10px 0 3px}
  .cbiz{font-size:14.5px;font-weight:600;line-height:1.35}
  .cmeta{font-size:12.5px;color:var(--dim);margin-top:5px;line-height:1.5}
  .cmeta b{color:var(--ink);font-weight:650}
  .opener{margin-top:14px;padding:13px 14px;background:var(--bg2);border-radius:13px}
  .opener .ol{font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);font-weight:700;margin-bottom:5px}
  .opener p{font-size:14px;line-height:1.5;font-weight:500}
  .srcline{margin-top:8px;font-size:11px;color:var(--dim);line-height:1.5}
  .srcline a{color:var(--teal);font-weight:600;border-bottom:1px solid rgba(15,141,132,.3)}

  .callbtn{
    display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;
    padding:15px;border-radius:16px;background:var(--green);color:#fff;font-size:17px;font-weight:700;
    letter-spacing:-.01em;box-shadow:0 5px 16px rgba(18,160,101,.28);
  }
  .callbtn:active{transform:scale(.985)}
  .callbtn svg{width:19px;height:19px;stroke:#fff;stroke-width:2.1;fill:none}
  .callbtn small{display:block;font-size:11.5px;opacity:.82;font-weight:600;letter-spacing:.02em;margin-top:1px}

  /* ── outcome ──────────────────────────────────────────── */
  .sec{margin-top:20px}
  .seclab{font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--dim);font-weight:750;margin-bottom:9px}
  .grid5{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
  .dbtn{padding:13px 2px;border-radius:13px;border:1px solid var(--line);background:var(--bg);
    color:var(--dim);font-size:10.5px;font-weight:750;line-height:1.25}
  .dbtn:active{transform:scale(.95)}
  .dbtn.on{border-color:transparent;color:#fff}
  .dbtn.na.on,.dbtn.vm.on{background:var(--dim)}
  .dbtn.ni.on{background:var(--red)} .dbtn.int.on{background:var(--amber)} .dbtn.bk.on{background:var(--green)}
  .glbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px 14px;border-radius:14px;border:1.5px solid var(--green);background:rgba(18,160,101,.08);color:var(--green);font-size:12.5px;font-weight:800;letter-spacing:.3px;margin-bottom:10px;cursor:pointer;transition:all .15s ease}
  .glbtn:active{transform:scale(.98)}
  .glbtn.on{background:var(--green);color:#fff;border-color:transparent;box-shadow:0 0 16px rgba(18,160,101,.4)}
  .glbtn .gldot{width:8px;height:8px;border-radius:50%;background:currentColor;display:inline-block}
  .killrow{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:6px}
  .kbtn{padding:11px 2px;border-radius:12px;border:1px dashed var(--line);background:none;
    color:var(--dim);font-size:10.5px;font-weight:700;line-height:1.25}
  .kbtn.on{background:var(--red);color:#fff;border-color:transparent;border-style:solid}
  .cbrow{display:flex;gap:6px;margin-top:10px;align-items:center;flex-wrap:wrap}
  .cbbtn{padding:8px 13px;border-radius:16px;border:1px solid var(--line);font-size:12px;font-weight:650;color:var(--dim)}
  .cbbtn.on{background:var(--blue);color:#fff;border-color:transparent}
  .note-in,.url-in{width:100%;background:var(--bg2);border:1px solid var(--line);border-radius:12px;
    font-size:13.5px;padding:11px 13px;outline:none;margin-top:9px}
  .note-in:focus,.url-in:focus{border-color:var(--teal)}

  /* ── send strip ───────────────────────────────────────── */
  .sendgrid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .sbtn{display:flex;flex-direction:column;gap:2px;padding:12px 13px;border-radius:14px;
    background:var(--bg2);border:1px solid var(--line);text-align:left}
  .sbtn:active{background:var(--bg3)}
  .sbtn .t{font-size:13px;font-weight:700}
  .sbtn .d{font-size:11px;color:var(--dim);line-height:1.3}
  .sbtn.hot{background:var(--pill);border-color:transparent}
  .sbtn.hot .t{color:var(--pill-ink)} .sbtn.hot .d{color:rgba(255,255,255,.6)}
  [data-theme="dark"] .sbtn.hot .d{color:rgba(0,0,0,.55)}
  .sbtn.wide{grid-column:1/-1;flex-direction:row;align-items:center;justify-content:space-between}
  .sbtn[disabled]{opacity:.42;pointer-events:none}

  .demobox{margin-top:9px;padding:13px;border-radius:14px;border:1px solid var(--line);background:var(--bg2)}
  .demobox .dh{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px}
  .demobox .dt{font-size:12.5px;font-weight:700}
  .demobox .ds{font-size:11px;color:var(--dim);line-height:1.45}
  .demolink{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
    margin-top:8px;font-size:11.5px;color:var(--teal);font-weight:600;word-break:break-all;line-height:1.4}
  .mini{padding:7px 12px;border-radius:10px;background:var(--pill);color:var(--pill-ink);
    font-size:11.5px;font-weight:700;flex-shrink:0}
  .mini.ghost{background:none;border:1px solid var(--line);color:var(--ink)}

  details.script{margin-top:16px;border-top:1px solid var(--line);padding-top:14px}
  details.script summary{list-style:none;font-size:12.5px;font-weight:700;color:var(--dim);
    display:flex;align-items:center;justify-content:space-between;cursor:pointer}
  details.script summary::-webkit-details-marker{display:none}
  details.script summary::after{content:"＋";font-size:15px}
  details.script[open] summary::after{content:"−"}
  .prose h3{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin:14px 0 4px;font-weight:750}
  .prose p{font-size:13.5px;line-height:1.55;color:var(--ink)}

  /* ── working ──────────────────────────────────────────── */
  .wcard{display:flex;gap:12px;align-items:flex-start;padding:14px;border-radius:16px;
    background:var(--bg2);margin-bottom:8px;text-align:left;width:100%;border:1px solid transparent}
  .wcard.due{border-color:rgba(200,50,31,.35);background:rgba(200,50,31,.055)}
  .wcard .bar{width:3px;align-self:stretch;border-radius:2px;background:var(--dim);flex-shrink:0}
  .wcard.due .bar{background:var(--red)} .wcard.hot .bar{background:var(--amber)}
  .wcard.won .bar{background:var(--green)}
  .wcard .b{flex:1;min-width:0}
  .wcard .t{font-size:14px;font-weight:680;line-height:1.25}
  .wcard .d{font-size:11.5px;color:var(--dim);margin-top:3px;line-height:1.45}
  .wcard .w{font-size:11px;font-weight:700;color:var(--dim);flex-shrink:0;text-align:right;line-height:1.35}
  .wcard.due .w{color:var(--red)}
  .grouph{font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--dim);
    font-weight:750;margin:20px 0 9px;display:flex;align-items:center;gap:8px}
  .grouph .n{background:var(--bg3);padding:2px 7px;border-radius:6px;font-size:10px}

  /* ── stats ────────────────────────────────────────────── */
  .hero{padding:20px;border-radius:18px;background:var(--bg2);text-align:center;margin-bottom:12px}
  .hero .num{font-size:52px;font-weight:750;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums}
  .hero .cap{font-size:12px;color:var(--dim);font-weight:600;margin-top:6px}
  .goal{height:5px;border-radius:3px;background:var(--bg3);margin-top:14px;overflow:hidden}
  .goal i{display:block;height:100%;background:var(--teal)}
  .kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .kpi{padding:14px;border-radius:14px;background:var(--bg2)}
  .kpi .n{font-size:24px;font-weight:730;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .kpi .c{font-size:11px;color:var(--dim);margin-top:2px;font-weight:600;line-height:1.3}
  .panel{margin-top:12px;padding:16px;border-radius:16px;background:var(--bg2)}
  .panel .cl{font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--dim);font-weight:750;margin-bottom:11px}
  table.ntab{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  table.ntab th{text-align:right;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;
    color:var(--dim);padding-bottom:7px;font-weight:750}
  table.ntab th:first-child,table.ntab td:first-child{text-align:left}
  table.ntab td{text-align:right;padding:5px 0;border-top:1px solid var(--line)}
  table.ntab td.g{color:var(--green);font-weight:700}
  .fbar{display:flex;align-items:center;gap:9px;margin-bottom:7px;font-size:12px}
  .fbar .fl{width:74px;color:var(--dim);font-weight:600;flex-shrink:0}
  .fbar .fb{flex:1;height:7px;border-radius:4px;background:var(--bg3);overflow:hidden}
  .fbar .fb i{display:block;height:100%;border-radius:4px}
