// ════════════════ SWIPE ════════════════
// The whole deck is one gesture. No Prev, no Next — drag the card. Mouse drag
// works too, so it behaves the same on the laptop as on the phone.
function armSwipe(){
  const card=$("card"), wrap=$("deckwrap"); if(!card) return;
  const hL=$("hintL"), hR=$("hintR");
  let x0=null, dx=0, id=null;
  const TH=72;

  const down=e=>{
    if(e.target.closest("input,select,textarea,details,a,button")) return;
    if(e.pointerType==="mouse" && e.button!==0) return;
    x0=e.clientX; dx=0; id=e.pointerId;
    card.classList.remove("snap"); card.setPointerCapture(id);
  };
  const move=e=>{
    if(x0===null||e.pointerId!==id) return;
    dx=e.clientX-x0;
    const r=Math.max(-1,Math.min(1,dx/160));
    card.style.transform=`translateX(${dx*.62}px) rotate(${r*2.2}deg)`;
    hR.style.opacity = dx<-TH?1:0;   // dragging left reveals "Next"
    hL.style.opacity = dx> TH?1:0;
  };
  const up=e=>{
    if(x0===null||e.pointerId!==id) return;
    card.classList.add("snap");
    hL.style.opacity=hR.style.opacity=0;
    if(Math.abs(dx)>TH){
      const dir = dx<0 ? 1 : -1;
      card.style.transform=`translateX(${dx<0?-460:460}px) rotate(${dx<0?-9:9}deg)`;
      setTimeout(()=>nav(dir),140);
    } else {
      card.style.transform="";
    }
    x0=null; try{ card.releasePointerCapture(id); }catch(_){}
  };
  card.addEventListener("pointerdown",down);
  card.addEventListener("pointermove",move,{passive:true});
  card.addEventListener("pointerup",up);
  card.addEventListener("pointercancel",up);
  wrap.addEventListener("dragstart",e=>e.preventDefault());
}
function nav(dir){
  const n=queueLeads().length; if(!n) return;
  idx=(idx+dir+n)%n;
  renderDial(); renderQueueBtn(); $("main").scrollTop=0;
}
function cbTime(h){
  const now=new Date();
  if(h===-9){ const t=new Date(now); t.setDate(t.getDate()+1); t.setHours(9,0,0,0); return t.toISOString(); }
  return new Date(now.getTime()+h*3600e3).toISOString();
}
function current(){ return queueLeads()[idx]; }

// ════════════════ WORKING ════════════════
// Everything still alive, in one place. This is the answer to "after I hit next
// on a dead one, I still need to get back to the ones that are going somewhere."
function buckets(){
  const now=Date.now(), due=[],green=[],hot=[],sent=[],won=[],back=[];
  leads.forEach(l=>{
    const d=results[key(l)]; if(!d||d.kill) return;
    const st=stageOf(d);
    if(d.dispo==="BOOKED"||st==="booked"){ won.push({l,d}); return; }
    if(d.dispo==="Not Interested" && !d.greenlight) return;
    const dueAt=[d.cbDue,d.fuDue].filter(Boolean).sort()[0];
    if(dueAt && new Date(dueAt).getTime()<=now){ due.push({l,d,when:dueAt}); return; }
    if(d.greenlight){ green.push({l,d,when:dueAt}); return; }
    // An interested lead is an interested lead. A pending 4-hour nudge does not
    // demote it into a diary entry — it shows as a time on the row instead.
    if(d.dispo==="Interested"){ hot.push({l,d,when:dueAt}); return; }
    if(STAGES.indexOf(st)>=STAGES.indexOf("demo_sent")){ sent.push({l,d,when:dueAt}); return; }
    if(dueAt){ back.push({l,d,when:dueAt}); return; }
  });
  due.sort((a,b)=>a.when<b.when?-1:1);
  back.sort((a,b)=>a.when<b.when?-1:1);
  const t=x=>x.when?new Date(x.when).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"}):(x.d.ts?ago(x.d.ts)+" ago":"");
  hot.forEach(x=>x.right=x.when?"nudge "+t(x):t(x)); sent.forEach(x=>x.right=x.when?"nudge "+t(x):t(x));
  green.forEach(x=>x.right=x.when?"nudge "+t(x):t(x));
  return {due,green,hot,sent,back,won};
}
function renderWork(){
  const v=$("scr-work"), b=buckets();
  const total=b.due.length+b.green.length+b.hot.length+b.sent.length+b.back.length+b.won.length;
  if(!total){
    v.innerHTML=`<h1>Working</h1><div class="sub">Live leads land here the moment you log an outcome.</div>
      <div class="empty">Nothing in play yet.<br>Mark someone <b>Interested</b> or send a demo and they'll show up here — so a dead call never costs you the live ones.</div>`;
    return;
  }
  const row=(x,cls,right)=>{
    const st=x.d.greenlight ? "🟢 Green Lit" : (STAGE_LABEL[stageOf(x.d)]||"");
    const ph=fmtPhone(x.l.phone);
    return `<button class="wcard ${cls}" onclick="openLead('${esc(jsq(key(x.l)))}')">
      <span class="bar"></span><span class="b">
        <span class="t">${esc(greet(x.l)||x.l.business_name)} <span style="font-size:11px;opacity:.75;font-weight:600;margin-left:6px">${esc(ph)}</span></span>
        <span class="d">${greet(x.l)?esc(x.l.business_name)+" · ":""}${st}${
          x.d.note?" · "+esc(x.d.note):""}</span></span>
      <span class="w">${right}</span></button>`;
  };
  const grp=(t,arr,fn)=>arr.length?`<div class="grouph">${t}<span class="n">${arr.length}</span></div>`+arr.map(fn).join(""):"";
  v.innerHTML=`<h1>Working</h1>
    <div class="sub">${total} live. Nothing here is a cold call — they all know who you are.</div>
    ${grp("🟢 Green Lit / Work in Progress", b.green, x=>row(x,"hot", x.right||""))}
    ${grp("Owed a call back now", b.due, x=>row(x,"due",(Date.now()-new Date(x.when)>36e5?"overdue<br>":"")+ago(x.when)+" ago"))}
    ${grp("Said interested",       b.hot, x=>row(x,"hot", x.right||""))}
    ${grp("Demo sent, waiting",    b.sent,x=>row(x,"hot", x.right||""))}
    ${grp("Called back later",     b.back,x=>row(x,"",new Date(x.when).toLocaleString("en-US",{weekday:"short",hour:"numeric",minute:"2-digit"})))}
    ${grp("Booked",                b.won, x=>row(x,"won","✓"))}
    ${meetings.length?`<div class="grouph">Calendar<span class="n">${meetings.length}</span></div>`+
      meetings.slice().sort((a,b2)=>a.when<b2.when?-1:1).map(m=>{
        const dt=new Date(m.when), past=dt<new Date();
        return `<div class="wcard ${past?"":"won"}" style="${past?"opacity:.5":""}">
          <span class="bar"></span><span class="b"><span class="t">${esc(m.name)}${past?" ✓":""}</span>
          <span class="d">${dt.toLocaleString("en-US",{weekday:"short",month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})} · ${m.dur} min${m.note?" · "+esc(m.note):""}</span></span>
          <span class="w"><button class="mini ghost" onclick="event.stopPropagation();downloadIcs('${m.id}')">.ics</button></span></div>`;
      }).join(""):""}`;
}
function openLead(k){
  const i=queueLeads().findIndex(l=>key(l)===k);
  if(i>=0){ idx=i; go("dial"); return; }
  queue=[]; deckOrder=null; saveQueue();       // outside the playlist — widen and jump
  const j=queueLeads().findIndex(l=>key(l)===k);
  idx=Math.max(0,j); go("dial"); renderQueueBtn();
}

// ════════════════ STATS ════════════════
function renderStats(){
  const v=$("scr-stats"), today=new Date().toISOString().slice(0,10);
  const all=Object.values(results).filter(d=>d.dispo||d.kill);
  const td=all.filter(d=>(d.ts||"").slice(0,10)===today);
  const conn=a=>a.filter(d=>["Not Interested","Interested","BOOKED"].includes(d.dispo));
  const cnt=(a,x)=>a.filter(d=>d.dispo===x).length;
  const pct=(a,b)=>b?Math.round(a/b*100):0;
  const kills=all.filter(d=>d.kill);
  const called=all.filter(d=>d.dispo).length, booked=cnt(all,"BOOKED");
  const inter=cnt(all,"Interested")+booked;

  const byN={};
  leads.forEach(l=>{
    const d=results[key(l)], o=byN[l.category]||(byN[l.category]={t:0,c:0,i:0,b:0,k:0});
    o.t++; if(d&&d.dispo){o.c++; if(["Interested","BOOKED"].includes(d.dispo))o.i++; if(d.dispo==="BOOKED")o.b++;}
    if(d&&d.kill) o.k++;
  });
  const gate={ok:0,check:0,held:0};
  leads.forEach(l=>{const s=(l.verify||{}).status; gate[s==="ok"?"ok":s==="check"?"check":"held"]++;});

  v.innerHTML=`<h1>Stats</h1><div class="sub">The scoreboard doesn't lie.</div>
    <div class="hero"><div class="num">${td.length}</div><div class="cap">dials today · goal ${DAILY_GOAL}</div>
      <div class="goal"><i style="width:${Math.min(100,pct(td.length,DAILY_GOAL))}%"></i></div></div>
    <div class="kpis">
      <div class="kpi"><div class="n">${conn(td).length}</div><div class="c">connects today</div></div>
      <div class="kpi"><div class="n">${cnt(td,"BOOKED")}</div><div class="c">booked today</div></div>
      <div class="kpi"><div class="n">${pct(conn(all).length,called)}%</div><div class="c">connect rate, all time</div></div>
      <div class="kpi"><div class="n">${pct(booked,called)}%</div><div class="c">book rate of called</div></div>
    </div>

    <div class="panel"><div class="cl">Lead quality — the number that cost you 09-01</div>
      <div class="fbar"><span class="fl">Clean</span><div class="fb"><i style="width:${pct(gate.ok,leads.length)}%;background:var(--green)"></i></div><span class="ft">${gate.ok}</span></div>
      <div class="fbar"><span class="fl">Caveated</span><div class="fb"><i style="width:${pct(gate.check,leads.length)}%;background:var(--amber)"></i></div><span class="ft">${gate.check}</span></div>
      <div class="fbar"><span class="fl">Held back</span><div class="fb"><i style="width:${pct(gate.held,leads.length)}%;background:var(--dim)"></i></div><span class="ft">${gate.held}</span></div>
      <div class="srcline" style="margin-top:10px">${kills.length
        ? `<b>${kills.length}</b> killed at the phone: `+KILLS.map(([k,lab])=>
            `${lab.toLowerCase()} ${kills.filter(d=>d.kill===k).length}`).join(" · ")+
          `. Export and merge these back — a defect found twice is a process that isn't working.`
        : "Nothing killed at the phone yet. Every kill you log here is a correction the corpus keeps."}</div>
    </div>

    <div class="panel"><div class="cl">Funnel — all time</div>
      ${[["Verified",gate.ok+gate.check,"var(--dim)"],["Called",called,"var(--blue)"],
         ["Interested",inter,"var(--amber)"],["Booked",booked,"var(--green)"]].map(([lab,n,c])=>
        `<div class="fbar"><span class="fl">${lab}</span><div class="fb"><i style="width:${pct(n,gate.ok+gate.check||1)}%;background:${c}"></i></div><span class="ft">${n}</span></div>`).join("")}
    </div>

    <div class="panel"><div class="cl">By niche</div>
      <table class="ntab"><tr><th>Niche</th><th>Leads</th><th>Called</th><th>Int</th><th>Bad</th><th>Booked</th></tr>
      ${Object.entries(byN).sort((a,b)=>b[1].c-a[1].c||b[1].t-a[1].t).map(([c,o])=>
        `<tr><td>${nlabel(c)}</td><td>${o.t}</td><td>${o.c}</td><td>${o.i}</td><td>${o.k||""}</td><td class="g">${o.b||""}</td></tr>`).join("")}
      </table></div>`;
}

// ════════════════ ACTIONS ════════════════
function go(name){
  scr=name;
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  $("scr-"+name).classList.add("active");
  document.querySelectorAll(".tab").forEach(t=>t.classList.toggle("active",t.dataset.scr===name));
  $("main").scrollTop=0; closeSheet(); render();
}
function render(){
  if(scr==="dial") renderDial(); else if(scr==="work") renderWork(); else renderStats();
  renderQueueBtn();
  $("avatar").textContent=rep;
  const n=buckets().due.length, b=$("workBadge");
  b.style.display=n?"":"none"; b.textContent=n;
}
function toggleGreenLight(){
  const l=current(); if(!l) return;
  const d=rec(l);
  d.greenlight = !d.greenlight;
  d.ts = new Date().toISOString();
  d.rep = rep;
  delete d.kill;
  if(d.greenlight){
    if(!d.dispo) d.dispo = "Interested";
    advance(d, "contacted");
    toast("🟢 Green Lit — Saved to Working!");
  } else {
    toast("Green light removed");
  }
  save();
  render();
}
function setDispo(dispo){
  const l=current(); if(!l) return;
  const d=rec(l);
  d.dispo=dispo; d.ts=new Date().toISOString(); d.rep=rep; delete d.kill;
  advance(d, dispo==="BOOKED"?"booked":"contacted");
  if(dispo==="Interested") armFollowup(d);
  if(dispo==="BOOKED"||dispo==="Not Interested") delete d.fuDue;
  save();
  if(dispo==="BOOKED"){ bookIt(); return; }
  // A dead outcome moves you on. A live one keeps the card up so you can send.
  if(dispo==="No Answer"||dispo==="Not Interested"){ toast(dispo+" — next"); setTimeout(()=>nav(1),260); }
  else render();
}
// The correction channel. Three dead leads on 09-01 were found with a dial and
// then forgotten; logged here they leave the deck AND come out in the export.
function setKill(k){
  const l=current(); if(!l) return;
  const d=rec(l);
  if(d.kill===k){ delete d.kill; save(); render(); return; }
  d.kill=k; d.ts=new Date().toISOString(); d.rep=rep;
  d.killNote=`${KILL_LABEL[k]} — found at the phone ${new Date().toLocaleDateString()}`;
  delete d.cbDue; delete d.fuDue;
  save(); toast(KILL_LABEL[k]+" — pulled from the deck");
  setTimeout(()=>{ idx=Math.max(0,idx-0); render(); },260);
}
function setCb(due){
  const l=current(); if(!l) return; const d=rec(l);
  if(due) d.cbDue=due; else delete d.cbDue;
  save(); render();
}
function setNote(v){ const l=current(); if(!l) return; rec(l).note=v; save(); }
function setDemoUrl(u){
  const l=current(); if(!l) return;
  u=(u||"").trim();
  if(u && !/^https?:\/\//i.test(u)){ toast("Needs to start with https://"); return; }
  const d=rec(l); if(u) d.demoUrl=u; else delete d.demoUrl;
  save(); render(); if(u) toast("Demo link saved — texts are live");
}
function markCalled(){ const l=current(); if(!l) return; const d=rec(l); if(!d.ts) d.ts=new Date().toISOString(); save(); }
function sent(k){
  const l=current(); if(!l) return; const d=rec(l);
  if(k==="pricing"){ advance(d,"pricing_sent"); delete d.fuDue; }
  else if(k==="demo"||k==="postvm"||k==="info"){ advance(d,"demo_sent"); armFollowup(d); }
  save(); setTimeout(render,400);
}
function buildDemo(){
  const l=current(); if(!l) return;
  copyText(buildCmd(l));
  const d=rec(l); d.demoRequested=new Date().toISOString(); save();
  toast("Build command copied — paste it in the terminal");
}
function bookIt(){
  const l=current(); if(!l) return;
  bookKey=key(l);
  $("bookSub").textContent=`${l.business_name}${greet(l)?" — "+greet(l):""}`;
  $("bDate").value=new Date(Date.now()+864e5).toISOString().slice(0,10);
  openSheet("bookSheet");
}
function saveMeeting(){
  const l=leads.find(x=>key(x)===bookKey); if(!l) return;
  const when=$("bDate").value+"T"+$("bTime").value;
  if(!$("bDate").value){ toast("Pick a date"); return; }
  const m={id:"m"+Date.now(), leadKey:bookKey, name:l.business_name, phone:l.phone,
    when:new Date(when).toISOString(), dur:+$("bDur").value, note:$("bNote").value, rep};
  meetings.push(m); saveMeetings();
  const d=rec(l); advance(d,"booked"); d.dispo="BOOKED"; d.ts=new Date().toISOString();
  delete d.fuDue; delete d.cbDue; save();
  downloadIcs(m.id); closeSheet(); go("work"); toast("Booked — .ics downloaded");
}
function downloadIcs(id){
  const m=meetings.find(x=>x.id===id); if(!m) return;
  const s=new Date(m.when), e=new Date(s.getTime()+m.dur*60000);
  const f=d=>d.toISOString().replace(/[-:]/g,"").slice(0,15)+"Z";
  const ics=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//RecoverRevenue//SalesHQ//EN","BEGIN:VEVENT",
    "UID:"+m.id+"@recoverrevenue","DTSTAMP:"+f(new Date()),"DTSTART:"+f(s),"DTEND:"+f(e),
    "SUMMARY:Demo call — "+String(m.name).replace(/[,;]/g," "),
    "DESCRIPTION:"+((m.note||"")+" · "+fmtPhone(m.phone)).replace(/[,;]/g," "),
    "BEGIN:VALARM","TRIGGER:-PT30M","ACTION:DISPLAY","DESCRIPTION:Pull up the demo link","END:VALARM",
    "END:VEVENT","END:VCALENDAR"].join("\r\n");
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([ics],{type:"text/calendar"}));
  a.download="meeting-"+String(m.name).replace(/\W+/g,"-").toLowerCase()+".ics";
  a.click();
}
function openTpl(){
  const l=current(); if(!l) return;
  const M=msgs(l), url=demoUrl(l);
  tplCache=Object.entries(M).map(([k,m])=>({k,...m,blocked:m.needsDemo&&!url}));
  $("tplSub").textContent=`${l.business_name} — filled in, ready to send`;
  $("tplBody").innerHTML=tplCache.map((t,i)=>`<div class="tpl">
    <div class="tk">${esc(t.label)}${t.blocked?" · needs a demo link":""}</div>
    <div class="tt">${esc(t.hint)}</div><div class="tb">${esc(t.body)}</div>
    <div class="tacts"><button class="mini ghost" onclick="copyTpl(${i},this)">Copy</button>
    ${t.blocked?"":`<a class="mini" href="${smsHref(l.phone,t.body)}" onclick="sent('${t.k}')">Text it</a>`}</div>
  </div>`).join("");
  openSheet("tplSheet");
}
function copyTpl(i,btn){
  const t=tplCache[i]; if(!t) return;
  copyText(t.body);
  if(btn){ btn.textContent="Copied ✓"; setTimeout(()=>btn.textContent="Copy",1200); }
}
function copyText(t){
  if(navigator.clipboard) navigator.clipboard.writeText(t).catch(()=>{});
  else{ const i=document.createElement("textarea"); i.value=t; document.body.appendChild(i);
        i.select(); document.execCommand("copy"); i.remove(); }
}
function switchRep(){
  const r=prompt("Rep initials (who's dialing?)",rep);
  if(r&&r.trim()){ rep=r.trim().toUpperCase().slice(0,4); localStorage.setItem("rr_rep",rep); render(); }
}
function exportResults(){
  const out={exported:new Date().toISOString(), rep,
    corrections:leads.filter(l=>(results[key(l)]||{}).kill).map(l=>({
      business_name:l.business_name, phone:l.phone, category:l.category,
      kill:results[key(l)].kill, note:results[key(l)].killNote })),
    leads:leads.map(l=>({...l, result:results[key(l)]||null})), meetings};
  const name="sales-hq-"+new Date().toISOString().slice(0,10)+".json";
  const json=JSON.stringify(out,null,2);
  const blob=new Blob([json],{type:"application/json"});
  const done=()=>toast(out.corrections.length+" corrections in the export");

  // iOS Safari ignores <a download> on a blob, so the day's calls would be
  // stranded on the phone. Share sheet first, anchor only as the desktop path.
  try{
    const f=new File([blob],name,{type:"application/json"});
    if(navigator.canShare && navigator.canShare({files:[f]})){
      navigator.share({files:[f],title:name})
        .then(done)
        .catch(err=>{ if(err && err.name!=="AbortError") anchorDownload(blob,name,done); });
      return;
    }
  }catch(_){}
  anchorDownload(blob,name,done);
}
function anchorDownload(blob,name,done){
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url; a.download=name; a.rel="noopener";
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
  if(done) done();
}
$("fileIn").addEventListener("change",e=>{
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=()=>{ try{
    const data=JSON.parse(r.result), arr=Array.isArray(data)?data:data.leads;
    if(!Array.isArray(arr)||!arr.length) return alert("Expected an array of leads.");
    const ungated=arr.filter(l=>!(l.verify||{}).status).length;
    if(ungated) return alert(`${ungated} of ${arr.length} leads have not been through verify.py.\n\nRun it first:\n  python3 ~/claude/agency/dialer/verify.py`);
    leads=arr.map(x=>{ const {result,...l}=x; return l; });
    idx=0; queue=[]; deckOrder=null; saveQueue(); closeSheet(); render();
    toast(leads.length+" leads loaded");
  }catch(err){ alert("Invalid JSON: "+err.message); } };
  r.readAsText(f);
});

// ════════════════ SHELL ════════════════
function openSheet(id){ $(id).classList.add("open"); $("scrim").classList.add("open"); }
function closeSheet(){
  document.querySelectorAll(".sheet").forEach(s=>s.classList.remove("open"));
  $("scrim").classList.remove("open");
}
function toggleTheme(){
  const d=document.documentElement;
  const next=d.getAttribute("data-theme")==="dark"?"light":"dark";
  d.setAttribute("data-theme",next); localStorage.setItem("rr_theme",next);
}
(function initTheme(){
  const saved=localStorage.getItem("rr_theme");
  if(saved) document.documentElement.setAttribute("data-theme",saved);
  else if(matchMedia("(prefers-color-scheme: dark)").matches)
    document.documentElement.setAttribute("data-theme","dark");
})();
document.addEventListener("keydown",e=>{
  if(/^(INPUT|SELECT|TEXTAREA)$/.test(e.target.tagName)) return;
  if(scr!=="dial") return;
  if(e.key==="ArrowRight") nav(1);
  if(e.key==="ArrowLeft")  nav(-1);
});
(function boot(){
  const g=(function(){const c={ok:0,check:0,held:0};
    leads.forEach(l=>{const s=(l.verify||{}).status; c[s==="ok"?"ok":s==="check"?"check":"held"]++;});return c;})();
  $("healthLine").innerHTML=`<b>${g.ok+g.check}</b> of ${leads.length} verified · `+
    `${g.check} carry a caveat · <b>${g.held}</b> held back by the gate`;
  $("repLine").innerHTML=`Calls get tagged <b>${esc(rep)}</b> — tap to change`;
  $("sheetRep").textContent = rep===REP_DEFAULT?"Chase":rep;
  render();
  if(!queue.length && !Object.keys(results).length) setTimeout(openQueue,420);
})();
</script>
