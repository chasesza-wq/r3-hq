// The hiring lane has no demo either. What it has is the job ad — the business saying,
// in public and with a salary attached, that its phone is not being answered. The card
// shows the posting and its URL so nothing said on the phone outruns the evidence.
// Three numbers, all sourced: what they published, what we cost, what is left over.
// Nothing estimated goes in this strip — the estimate lives behind the meta details.
function numStrip(l){
  const y1 = PRICING.setup + PRICING.mo*12;
  if(isHiring(l)){
    const pay = payOf(l);
    const m = (l.source||"").match(/(\d{4})-(\d{2})-(\d{2})/);
    let age = "";
    if(m){
      const d = Math.round((Date.now()-new Date(+m[1],+m[2]-1,+m[3]).getTime())/864e5);
      age = d<=0?"today":d===1?"1 day":d+" days";
    }
    if(!pay) return `<div class="numstrip">
      <div><b>$${PRICING.setup.toLocaleString()}</b><i>setup</i></div>
      <div><b>$${PRICING.mo}</b><i>per month</i></div>
      <div><b>${age||"—"}</b><i>ad has been up</i></div></div>`;
    return `<div class="numstrip">
      <div><b>$${pay.toLocaleString()}</b><i>salary posted</i></div>
      <div><b>$${y1.toLocaleString()}</b><i>us, year one</i></div>
      <div class="good"><b>$${(pay-y1).toLocaleString()}</b><i>left over</i></div></div>`;
  }
  if(isAeo(l)) return "";
  return `<div class="numstrip">
    <div><b>$${PRICING.setup.toLocaleString()}</b><i>setup</i></div>
    <div><b>$${PRICING.mo}</b><i>per month</i></div>
    <div class="good"><b>15</b><i>jobs before it bills</i></div></div>`;
}

