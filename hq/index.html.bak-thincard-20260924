let queue    = JSON.parse(localStorage.getItem("rr_queue")||"[]");
let rep      = localStorage.getItem("rr_rep")||REP_DEFAULT;
let scr="dial", idx=0, bookKey=null, tplCache=[];

function save(){
  localStorage.setItem("rr_results",JSON.stringify(results));
  pushDial();
}

// ── telemetry ────────────────────────────────────────────────────────────
// A dial that is not logged did not happen. This page only ever wrote to
// localStorage, so "how many did you make yesterday" has never been an
// answerable question. Loopback only, fire-and-forget, silent when the
// display server is not running. Never let it break a call.
const DIAL_SINK="http://127.0.0.1:5090/dial";
function dialStats(){
  const now=new Date(), d0=new Date(now.getFullYear(),now.getMonth(),now.getDate());
  const w0=new Date(d0); w0.setDate(d0.getDate()-((d0.getDay()+6)%7));
  let today=0,week=0,contacts=0,booked=0,bad=0,last=null;
  for(const k in results){
    const d=results[k]; if(!d||!d.ts) continue;
    const t=new Date(d.ts);
    if(!last||t>last) last=t;
    if(t>=w0) week++;
    if(t>=d0){
      today++;
      if(d.kill) bad++;
      else if(d.dispo && d.dispo!=="No Answer" && d.dispo!=="Voicemail") contacts++;
      if(d.dispo==="BOOKED") booked++;
    }
  }
  return {today,week,contacts,booked,bad,last:last?last.toISOString():null,rep};
}
function pushDial(){
  try{
    // The aggregate says how many. `results` says which lead and what happened —
    // without it a booking can never be traced back to the demo that earned it,
    // and clearing site data erases the only copy that exists.
    const body=JSON.stringify(Object.assign(dialStats(),{results}));
    fetch(DIAL_SINK,{method:"POST",headers:{"Content-Type":"application/json"},
      body,keepalive:true}).catch(()=>{});
  }catch(_){}
}
function saveQueue(){ localStorage.setItem("rr_queue",JSON.stringify(queue)); }
// Card mode deals one lead at a time; list mode is the sheet of numbers. The choice
// sticks, because a preference you re-pick every load is not a preference.
let dialMode = localStorage.getItem("rr_dialmode")==="list" ? "list" : "cards";
let listOpen = null;
function setDialMode(m){ dialMode=m; listOpen=null; localStorage.setItem("rr_dialmode",m); renderDial(); }
function toggleRow(k){ listOpen = (listOpen===k?null:k); renderDial(); }
function saveMeetings(){ localStorage.setItem("rr_meetings",JSON.stringify(meetings)); }
function rec(l, peek){ const k=key(l); return peek ? results[k] : (results[k]||(results[k]={})); }
function stageOf(d){ return (d&&d.stage) || (d&&d.dispo?"contacted":"new"); }
function advance(d,s){ if(STAGES.indexOf(s)>=STAGES.indexOf(stageOf(d))) d.stage=s; }
function armFollowup(d){
  if(STAGES.indexOf(stageOf(d))<STAGES.indexOf("pricing_sent") && !d.fuDue)
    d.fuDue=new Date(Date.now()+FOLLOWUP_HOURS*3600e3).toISOString();
}
function toast(msg){
  const t=$("toast"); t.textContent=msg; t.classList.add("on");
  clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("on"),2100);
}

// ════════════════ THE QUEUE ════════════════
// Not a wall of filters. A playlist: pick the niches, in order, and dial.
// Only leads the verify gate cleared are ever in it.
function diallable(l){ const s=(l.verify||{}).status; return s==="ok"||s==="check"; }
function killed(l){ const d=rec(l,true); return !!(d&&d.kill); }

function niches(){
  const m={};
  leads.forEach(l=>{
    const o=m[l.category]||(m[l.category]={total:0,ready:0,warn:0,dead:0,left:0});
    o.total++;
    const s=(l.verify||{}).status;
    if(s==="ok") o.ready++;
    else if(s==="check") o.warn++;
    else o.dead++;
    if(diallable(l) && !killed(l) && !(rec(l,true)||{}).dispo) o.left++;
  });
  return m;
}
// The deck order is fixed the moment you start, and does NOT re-sort as you
// work. Sorting live meant logging an outcome silently swapped the card under
// you mid-call — you'd hit Interested and be looking at somebody else.
// Killed leads still drop out; nothing else moves until the queue changes.
let deckOrder = null;
function buildDeck(){
  // With no queue picked, hiring leads go first. They are the only records where the
  // business published the problem itself — burying them behind 1,000 licence-roll
  // numbers is how a found lead becomes a lead that was never called.
  const src = queue.length ? queue
    : Object.keys(niches()).sort((a,b)=>(a.indexOf("hiring:")===0?0:1)-(b.indexOf("hiring:")===0?0:1));
  const out = [];
  src.forEach(c=>{
    leads.filter(l=>l.category===c && diallable(l))
      .sort((a,b)=>{
        const da=rec(a,true)||{}, db=rec(b,true)||{};
        if(!!da.dispo !== !!db.dispo) return da.dispo?1:-1;          // uncalled first
        const sa=(a.verify||{}).status==="ok"?0:1, sb=(b.verify||{}).status==="ok"?0:1;
        if(sa!==sb) return sa-sb;                                     // clean before caveated
        return (b.review_count||0)-(a.review_count||0);
      }).forEach(l=>out.push(key(l)));
  });
  deckOrder = out;
  return out;
}
function queueLeads(){
  const order = deckOrder || buildDeck();
  const byKey = {};
  leads.forEach(l=>{ byKey[key(l)]=l; });
  return order.map(k=>byKey[k]).filter(l=>l && diallable(l) && !killed(l));
}
function queueName(){
  if(!queue.length) return "Everything verified";
  return queue.map(nlabel).join(" → ");
}
function renderQueueBtn(){
  $("qName").textContent = queueName();
  const left = queueLeads().filter(l=>!(rec(l,true)||{}).dispo).length;
  $("qLeft").textContent = left ? left+" left" : "";
}
function openQueue(){
  const m=niches();
  const order=Object.keys(NICHE).filter(c=>m[c]);
  $("queueRows").innerHTML = order.map(c=>{
    const o=m[c], pos=queue.indexOf(c);
    const bits=[];
    if(o.ready) bits.push(`<b>${o.ready} ready</b>`);
    if(o.warn)  bits.push(`<span class="warnn">${o.warn} with a caveat</span>`);
    if(o.dead)  bits.push(`<span class="deadn">${o.dead} held back</span>`);
    return `<button class="qrow ${pos>=0?"on":""} ${o.ready+o.warn?"":"zero"}" onclick="toggleQ('${c}')">
      <span class="qord">${pos>=0?pos+1:"+"}</span>
      <span class="b"><span class="t">${NICHE[c].label}</span>
      <span class="d">${bits.join(" · ")||"nothing verified yet"}</span></span>
      <span class="qn">${o.left||""}</span></button>`;
  }).join("");
  const picked=queue.reduce((n,c)=>n+((m[c]||{}).ready||0)+((m[c]||{}).warn||0),0);
  const total=Object.values(m).reduce((n,o)=>n+o.ready+o.warn,0);
  $("queueSub").textContent = queue.length
    ? `${picked} verified ${picked===1?"lead":"leads"} in this playlist.`
    : `Tap niches in the order you want to work them. ${total} verified across all of them.`;
  const held=Object.values(m).reduce((n,o)=>n+o.dead,0);
  $("queueNote").innerHTML = `<b>${total} of ${leads.length}</b> leads cleared the verify gate. `+
    `${held} are held back — no source URL, wrong market, or reported closed. `+
    `They never enter the deck. Run <b>verify.py</b> after every scrape.`;
  $("queueGo").textContent = queue.length ? `Start dialing — ${picked} leads` : "Dial everything verified";
  openSheet("queueSheet");
}
function toggleQ(c){
  const i=queue.indexOf(c);
  if(i>=0) queue.splice(i,1); else queue.push(c);
  deckOrder=null; saveQueue(); openQueue();
}
function clearQueue(){ queue=[]; deckOrder=null; saveQueue(); openQueue(); }
function startQueue(){
  idx=0; deckOrder=null; buildDeck(); saveQueue(); closeSheet(); go("dial"); renderQueueBtn();
  toast(queue.length ? "Queue set — "+queueName() : "Dialing everything verified");
}

