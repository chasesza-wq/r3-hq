// ════════════════ HELPERS ════════════════
const $ = id => document.getElementById(id);
function key(l){ return (l.business_name||"") + "|" + (l.phone||""); }
function esc(s){ return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function jsq(s){ return String(s??"").replace(/\\/g,"\\\\").replace(/'/g,"\\'"); }
function fmtPhone(p){ const d=String(p||"").replace(/\D/g,""); return d.length===10?`(${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}`:p; }
function telHref(p){ return "tel:"+String(p||"").replace(/[^\d+]/g,""); }
function smsHref(p, body){
  const n=String(p||"").replace(/[^\d+]/g,"");
  const sep=/iPhone|iPad|Mac/i.test(navigator.userAgent)?"&":"?";
  return `sms:${n}${sep}body=${encodeURIComponent(body)}`;
}
function nlabel(c){ return (NICHE[c]||{}).label || c || ""; }
function inWindow(c){
  const w=(NICHE[c]||{}).win||DEFAULT_WIN, n=new Date(), h=n.getHours()+n.getMinutes()/60;
  return w.some(([a,b])=>h>=a&&h<b);
}
function closedToday(l){
  const days=l.closed_days||[]; if(!days.length) return false;
  return days.includes(["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][new Date().getDay()]);
}
function ago(iso){
  const m=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/60000));
  if(m<60) return m+"m"; const h=Math.floor(m/60);
  return h<24 ? h+"h" : Math.floor(h/24)+"d";
}
function firstName(l){
  const n=(l.owner_name||"").trim();
  return n ? n.split(" ")[0] : null;
}
// The opener only asserts a name the verify pass actually sourced. A name that
// was lifted off the sign gets asked, not assumed — "is this Mike?" is right
// whether or not Mike picks up. Assuming it is what "wrong name" felt like.
function greet(l){
  const v=l.verify||{};
  return (v.opener==="named" && firstName(l)) ? firstName(l) : null;
}
function askName(l){
  const v=l.verify||{};
  return (v.opener==="ask" && firstName(l)) ? firstName(l) : null;
}
function openLine(l, who){
  if(isAeo(l)){
    const a=l.aeo||{}, comp=(a.competitors||[]).slice(0,2);
    const q=`best ${AEO_NOUN[l.category]||nlabel(l.category)} in ${a.query||l.city}`;
    return `"Hey — is the owner around? … ${who}, I'll be quick. I'm a student, I do AI search visibility for ${esc(nlabel(l.category).replace(" (AI)","").toLowerCase())} companies. Honestly I don't Google anymore — I asked Claude '${esc(q)}' this morning and you weren't in the answer. ${comp.length?esc(comp.join(" and "))+" were.":""} Got twenty seconds?"`;
  }
  // The opener asks about the phone, not a website. We stopped selling websites 2026-09-23.
  const n=greet(l), a=askName(l), q=questions(l).ask;
  if(n) return `"Hey ${esc(n)}, this is ${who} — I'll be quick. ${esc(q)}"`;
  if(a) return `"Hey — is this ${esc(a)}? This is ${who}, I'll be quick. ${esc(q)}"`;
  return `"Hey, is this the owner of ${esc(l.business_name||"")}? This is ${who}, I'll be quick. ${esc(q)}"`;
}

// Rough yearly intake, recomputed from the one number that has a source.
// The old corpus stored est_revenue_annual as a flat field with no visible
// derivation, which made an assumption look like a fact. This shows its work.
function intake(l){
  const rc=l.review_count||0; if(!rc) return null;
  const t=TICKET[l.category]||TICKET.default;
  const yr=rc*JOBS_PER_REVIEW*t;
  return { yr, t, jobs:rc*JOBS_PER_REVIEW,
    pretty: yr>=1e6 ? "$"+(yr/1e6).toFixed(1)+"M" : "$"+Math.round(yr/1000)+"k" };
}

// The opener is a question, not a pitch. Every one of these has exactly one
// honest answer — "a website" — and the owner says it out loud instead of
// hearing it from a stranger. That is the whole play.
const URGENT = { towing:"a tow", mobile_mechanic:"a mechanic at the roadside",
  appliance_repair:"a fridge fixed tonight", tree_service:"a limb off their roof",
  junk_removal:"a cleanout booked", pressure_washing:"a quote before a closing",
  lawn_care:"a yard cut before Saturday", handyman:"something fixed today",
  car_detailing:"a car detailed before the weekend" };

// Two ways to start, because one script for every pickup is how you sound like a script.
// A is the evidence they published. B is the question that makes them say the problem
// out loud — it works on a lead that published nothing, which is most of them.
function openers(l){
  if(isAeo(l)){
    const a=l.aeo||{}, comp=(a.competitors||[]).slice(0,2);
    return [
      {tag:"The AI check", line:`I asked Claude "best ${AEO_NOUN[l.category]||nlabel(l.category)} in ${a.query||l.city}" this morning and you weren't in the answer.${comp.length?" "+comp.join(" and ")+" were.":""} Got twenty seconds?`},
      {tag:"The Google gap", line:`You're paying Google to sit at the top — and the customer who asks AI instead never sees Google at all. Can I send you what I found?`},
    ];
  }
  if(isHiring(l)){
    const role=l.posted_role||"front desk";
    return [
      {tag:"Saw the job post", line:`I saw you're hiring a ${role} — how many calls are going to voicemail right now?`},
      {tag:"After hours", line:`Quick one — what time do you guys close? … So what happens to the calls that come in after that?`},
    ];
  }
  return [
    {tag:"The rung-out phone", line:`When you're on a job and the phone rings out — who picks that up?`},
    {tag:"After hours", line:`Quick one — what time do you finish for the day? … So what happens to the calls that come in after that?`},
  ];
}

function questions(l){
  if(isAeo(l)){
    const a=l.aeo||{}, comp=(a.competitors||[]);
    return {
      ask: `When somebody asks ChatGPT "who's the best ${AEO_NOUN[l.category]||nlabel(l.category)} in ${a.query||l.city}" — do you know who it names?`,
      then: comp.length?`It's <b>${comp.slice(0,2).join(" and ")}</b>. Not you. Checked ${a.of||3} ways this morning.`
                       :`It isn't you — checked ${a.of||3} ways this morning.`,
    };
  }
  if(isHiring(l)){
    return {
      ask: `I saw you're hiring a ${l.posted_role||"front desk"} — how many calls are going to voicemail right now?`,
      then: `Then: <b>"What time do you close?"</b> → <b>"So what happens to the calls that come in after that?"</b> That is the sale. Let them answer it.`,
    };
  }
  return {
    ask: `When you're on a job and the phone rings out — who picks that up?`,
    then: `Then: <b>"What time do you finish?"</b> → <b>"So what happens to the calls that come in after that?"</b> That is the sale. Let them answer it.`,
  };
}

