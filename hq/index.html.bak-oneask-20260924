    return [
      `When somebody asks ChatGPT or Claude "who's the best ${AEO_NOUN[l.category]||nlabel(l.category)} in ${a.query||l.city}" — do you know who it names?`,
      comp.length?`It's ${comp.slice(0,2).join(" and ")}. Not you. I checked ${a.of||3} different ways this morning.`:`It isn't you — I checked ${a.of||3} different ways this morning.`,
      "You're paying Google to be at the top — and the customer who asks AI instead never sees Google at all.",
      "Can I email you the check I ran? Score, who came up instead, and the four things causing it. Free.",
    ];
