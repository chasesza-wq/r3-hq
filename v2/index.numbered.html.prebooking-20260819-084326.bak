<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[NUMBERED] RecoverRevenue — Websites & AI systems that make local businesses money</title>
<meta name="description" content="We build websites, AI phone systems and lead engines that recover the revenue local businesses are losing to missed calls and outdated sites. Live in 7 business days.">
<link rel="icon" type="image/svg+xml" href="assets/logo-mark.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#ffffff; --paper2:#f3f4f6; --ink:#16181d; --dim:#6d7078;
    --line:rgba(22,24,29,.1); --blue:#1b48c8; --blue-soft:rgba(27,72,200,.08);
    --sky:#7ea8ff; --dark:#101216; --dark2:#16191f; --dark-ink:#f2f3ef;
    --dark-line:rgba(242,243,239,.1);
    --disp:'Bricolage Grotesque',sans-serif; --mono:'Space Mono',monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter',sans-serif;background:var(--paper);color:var(--ink);
    -webkit-font-smoothing:antialiased;overflow-x:hidden;
    background-image:radial-gradient(rgba(22,24,29,.05) 1px,transparent 1px);
    background-size:26px 26px;
  }
  ::selection{background:var(--blue);color:#fff}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  h1,h2,h3{font-family:var(--disp);letter-spacing:-.02em}
  .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);font-weight:700;margin-bottom:18px}
  .h2{font-size:clamp(2rem,4.6vw,3.6rem);font-weight:800;line-height:1.04;margin-bottom:18px}
  .lead{font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:var(--dim);max-width:600px}
  .lead b{color:var(--ink)}
  section{padding:clamp(80px,10vw,136px) 0}
  .line-mask{overflow:hidden;display:block}
  .line-mask>span{display:block;transform:translateY(112%)}
  .rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,.7,.3,1);transition-delay:var(--d,0s)}
  .rv.in{opacity:1;transform:none}

  /* ---------- nav — glass pill + sliding spotlight (V2) ---------- */
  nav{
    position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:90;
    display:flex;align-items:center;gap:2px;padding:6px;
    background:rgba(255,255,255,.78);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border:1px solid var(--line);border-radius:99px;max-width:calc(100vw - 28px);
    box-shadow:0 6px 30px rgba(22,24,29,.06);
  }
  nav .spot{
    position:absolute;top:0;bottom:0;width:84px;border-radius:99px;left:0;
    background:radial-gradient(circle at 50% 130%,var(--blue-soft),transparent 72%);
    opacity:0;transition:opacity .25s;pointer-events:none;
  }
  nav a{
    position:relative;z-index:1;font-size:13px;font-weight:600;color:var(--dim);
    text-decoration:none;padding:8px 13px;border-radius:99px;transition:color .2s;white-space:nowrap;
  }
  nav a:hover{color:var(--ink)}
  nav .brand{font-family:var(--disp);font-weight:800;color:var(--ink);letter-spacing:-.01em}
  nav .brand i{font-style:normal;color:var(--blue)}
  nav .cta{background:var(--ink);color:#fff !important;font-weight:700}
  @media(max-width:820px){nav a:not(.brand):not(.cta){display:none}}

  /* ---------- hero ---------- */
  header{position:relative;min-height:100svh;display:flex;align-items:center;padding:120px 0 70px;overflow:hidden}
  .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:56px;align-items:center}
  @media(max-width:960px){.hero-grid{grid-template-columns:1fr}}
  .hero-h1{font-size:clamp(2.7rem,6.6vw,5.3rem);font-weight:800;line-height:1.0;letter-spacing:-.03em}
  .hero-h1 .stroke{color:transparent;-webkit-text-stroke:1.5px var(--ink)}
  .flipword{display:inline-block;perspective:500px;color:var(--blue);min-width:5.4em}
  .flipword>span{display:inline-block;transform-origin:50% 100%;will-change:transform}
  @keyframes flipOut{to{transform:rotateX(90deg);opacity:0}}
  @keyframes flipIn{from{transform:rotateX(-90deg);opacity:0}to{transform:rotateX(0);opacity:1}}
  .hero-sub{margin-top:26px}
  .hero-cta-row{display:flex;align-items:center;gap:26px;margin-top:38px;flex-wrap:wrap}

  /* U1 pushable */
  .push{cursor:pointer;border:none;background:none;padding:0;text-decoration:none;display:inline-block;outline-offset:4px}
  .push .edge{border-radius:14px;background:#0f2e83;display:block}
  .push .face{
    display:block;border-radius:14px;background:var(--blue);color:#fff;font-family:'Inter',sans-serif;
    font-size:15px;font-weight:700;padding:15px 28px;transform:translateY(-6px);transition:transform .1s;
  }
  .push:hover .face{transform:translateY(-7px)}
  .push:active .face{transform:translateY(-1px)}
  .push.dark-edge .edge{background:#9aa092}
  .push.dark-edge .face{background:var(--dark-ink);color:var(--dark)}

  /* S3 avatars trust row */
  .trust{display:flex;align-items:center;gap:14px}
  .avrow{display:flex;padding-left:12px}
  .av{
    width:40px;height:40px;border-radius:50%;margin-left:-11px;border:2px solid var(--paper);
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px;color:#fff;
    transition:transform .3s cubic-bezier(.34,1.56,.64,1);position:relative;cursor:default;
  }
  .av:hover{transform:scale(1.3) translateY(-5px);z-index:5}
  .av::after{
    content:attr(data-n);position:absolute;bottom:calc(100% + 8px);left:50%;
    transform:translateX(-50%) scale(.92);background:var(--ink);color:#fff;font-size:10px;font-weight:600;
    padding:4px 9px;border-radius:6px;opacity:0;transition:.2s;white-space:nowrap;pointer-events:none;
  }
  .av:hover::after{opacity:1;transform:translateX(-50%) scale(1)}
  .trust small{font-size:12.5px;color:var(--dim);line-height:1.45}
  .trust small b{color:var(--ink)}

  /* S1 dynamic island — live product mock in hero */
  .hero-visual{position:relative;display:flex;flex-direction:column;gap:18px;align-items:center}
  .phone-card{
    width:min(330px,100%);background:#fff;border:1px solid var(--line);border-radius:24px;
    box-shadow:0 24px 60px rgba(22,24,29,.1);padding:20px;position:relative;
  }
  .phone-card .ph-head{display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:10.5px;color:var(--dim);letter-spacing:.1em;margin-bottom:14px}
  .phone-card .ph-head b{color:var(--blue)}
  .island{
    margin:0 auto;width:150px;height:36px;background:var(--ink);border-radius:22px;color:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;position:relative;
    transition:width .55s cubic-bezier(.34,1.56,.64,1),height .55s cubic-bezier(.34,1.56,.64,1),border-radius .45s;
  }
  .island .pill-state{display:flex;align-items:center;gap:8px;font-size:11.5px;color:#c9ccc4;transition:opacity .2s}
  .island .dot{width:7px;height:7px;border-radius:50%;background:var(--sky);animation:pulse 1.6s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
  .island .card-state{position:absolute;inset:0;padding:15px 17px;opacity:0;transition:opacity .25s;pointer-events:none;text-align:left}
  .island .card-state .t{font-size:12.5px;font-weight:700}
  .island .card-state .s{font-size:11px;color:#9aa0a8;margin-top:3px;line-height:1.45}
  .island.open{width:100%;height:96px;border-radius:18px}
  .island.open .pill-state{opacity:0}
  .island.open .card-state{opacity:1;transition-delay:.22s}
  .ph-lines{margin-top:16px;display:flex;flex-direction:column;gap:9px}
  .ph-line{display:flex;justify-content:space-between;font-size:12px;color:var(--dim);border-bottom:1px dashed var(--line);padding-bottom:8px}
  .ph-line b{color:var(--ink);font-variant-numeric:tabular-nums}
  .ph-line .g{color:var(--blue)}
  .hero-visual .cap{font-family:var(--mono);font-size:10.5px;color:var(--dim);letter-spacing:.12em;text-align:center}

  /* ---------- kinetic band (A3) ---------- */
  .kinetic{overflow:hidden;padding:30px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper2)}
  .kinetic .row{display:flex;gap:44px;white-space:nowrap;will-change:transform}
  .kinetic .row span{
    font-family:var(--disp);font-weight:800;font-size:clamp(1.8rem,4.2vw,3.2rem);
    color:transparent;-webkit-text-stroke:1px rgba(22,24,29,.35);text-transform:uppercase;letter-spacing:-.01em;
  }
  .kinetic .row span.f{color:var(--blue);-webkit-text-stroke:0}

  /* ---------- sticky problem section (C2) ---------- */
  .sticky-sec{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
  @media(max-width:900px){.sticky-sec{grid-template-columns:1fr;gap:36px}}
  .sticky-left{position:sticky;top:110px}
  @media(max-width:900px){.sticky-left{position:static}}
  .sdots{display:flex;gap:7px;margin-top:28px}
  .sdots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:.3s}
  .sdots i.on{background:var(--blue);transform:scale(1.25)}
  .leak-card{
    background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px;margin-bottom:20px;
    transition:border-color .3s, transform .3s;
  }
  .leak-card:hover{border-color:rgba(27,72,200,.35);transform:translateY(-3px)}
  .leak-card .n{font-family:var(--mono);font-size:12px;color:var(--blue);font-weight:700}
  .leak-card h3{font-size:20px;font-weight:700;margin:10px 0 8px;font-family:'Inter',sans-serif;letter-spacing:0}
  .leak-card p{font-size:14px;line-height:1.6;color:var(--dim)}
  .leak-card .stat{font-family:var(--disp);font-size:30px;font-weight:800;color:var(--ink);margin-top:14px;font-variant-numeric:tabular-nums}
  .leak-card .stat small{font-size:13px;font-weight:600;color:var(--dim);font-family:'Inter',sans-serif}

  /* ---------- services — shift cards (C1) + cursor displacement (V5) ---------- */
  .svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:52px}
  @media(max-width:960px){.svc-grid{grid-template-columns:1fr}}
  .svc{
    display:block;background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;cursor:pointer;
    color:inherit;text-decoration:none;
    position:relative;opacity:0;transform:translateY(30px);transition:border-color .3s,box-shadow .3s;
  }
  .svc:hover{box-shadow:0 18px 44px rgba(22,24,29,.09)}
  .svc.in{animation:cardin .7s cubic-bezier(.22,.7,.3,1) forwards}
  @keyframes cardin{to{opacity:1;transform:none}}
  .svc:hover{border-color:rgba(27,72,200,.4)}
  .svc .glow{
    position:absolute;inset:0;opacity:0;transition:opacity .35s;pointer-events:none;z-index:1;
    background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(27,72,200,.07),transparent 70%);
  }
  .svc:hover .glow{opacity:1}
  .svc .media{height:210px;position:relative;overflow:hidden}
  .svc .media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.22,.7,.3,1)}
  .svc:hover .media img{transform:scale(1.06)}
  .svc .media.m-web::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,18,22,.02) 35%,rgba(16,18,22,.42));pointer-events:none}
  .chip{
    position:absolute;z-index:2;left:14px;bottom:14px;max-width:calc(100% - 28px);
    background:rgba(255,255,255,.95);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    border-radius:12px;box-shadow:0 12px 28px rgba(22,24,29,.3);padding:10px 13px;
    display:flex;align-items:center;gap:10px;animation:chipbob 4.5s ease-in-out infinite;
  }
  @keyframes chipbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
  .chip .ct{font-size:11.5px;font-weight:700;color:var(--ink);line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .chip .ct small{display:block;font-weight:500;font-size:10px;color:var(--dim)}
  .chip .live-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);animation:pulse 1.6s infinite;flex:none}
  .chip .mini-btn{font-size:10.5px;font-weight:700;background:var(--blue);color:#fff;border-radius:8px;padding:5px 9px;white-space:nowrap;flex:none}
  .chip .wave{display:flex;gap:2.5px;align-items:flex-end;height:16px;flex:none}
  .chip .wave i{width:3px;background:var(--blue);border-radius:2px;height:6px;animation:wv 1s ease-in-out infinite}
  .chip .wave i:nth-child(2){animation-delay:.12s}.chip .wave i:nth-child(3){animation-delay:.24s}
  .chip .wave i:nth-child(4){animation-delay:.36s}.chip .wave i:nth-child(5){animation-delay:.48s}
  @keyframes wv{0%,100%{height:5px}50%{height:16px}}
  .chip .stars{font-size:12px;color:#f0a500;letter-spacing:2px;flex:none}
  .svc .body{padding:22px 24px 24px;position:relative;z-index:2}
  .svc .tag{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--blue);font-weight:700}
  .svc h3{font-size:21px;margin:8px 0 6px;letter-spacing:-.01em}
  .svc .pitch{font-size:14px;line-height:1.6;color:var(--dim)}
  .svc .go{
    display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-size:13px;font-weight:700;color:var(--blue);
  }
  .svc .go::after{content:'→';transition:transform .3s}
  .svc:hover .go::after{transform:translateX(4px)}
  .m-web{background:linear-gradient(135deg,#e8ecf9,#c9d6f4)}
  .m-phone{background:linear-gradient(135deg,#0c0e12,#1d2330)}
  .m-rev{background:linear-gradient(135deg,#eef1f8,#dde4f3)}
  .m-lead{background:linear-gradient(135deg,#eef1f8,#dde4f3)}

  /* in-card live demos — call transcript + SMS threads */
  .demo{position:absolute;inset:0;padding:16px 18px;display:flex;flex-direction:column;gap:8px;justify-content:flex-end}
  .demo .dhead{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;margin-bottom:auto;display:flex;align-items:center;gap:7px}
  .demo .ln{opacity:0;animation:demoln 9s infinite both}
  .demo .ln:nth-child(2){animation-delay:.4s}
  .demo .ln:nth-child(3){animation-delay:2.2s}
  .demo .ln:nth-child(4){animation-delay:4s}
  .demo .ln:nth-child(5){animation-delay:5.8s}
  @keyframes demoln{0%{opacity:0;transform:translateY(8px)}4%{opacity:1;transform:none}88%{opacity:1;transform:none}94%,100%{opacity:0}}
  .demo-call .dhead{color:#8b93a5}
  .demo-call .dhead i{width:7px;height:7px;border-radius:50%;background:#69d18f;animation:pulse 1.6s infinite}
  .demo-call .ln{font-size:12px;line-height:1.5;color:#c7cdd8;max-width:92%}
  .demo-call .ln b{display:block;font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:#69d18f;margin-bottom:2px;font-weight:700}
  .demo-call .ln.caller b{color:#8b93a5}
  .demo-sms .dhead{color:var(--dim)}
  .demo-sms .ln{font-size:12.5px;line-height:1.45;padding:8px 12px;border-radius:14px;max-width:82%}
  .demo-sms .ln.out{background:var(--blue);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
  .demo-sms .ln.in{background:#fff;color:var(--ink);align-self:flex-start;border-bottom-left-radius:4px;box-shadow:0 2px 8px rgba(22,24,29,.07)}
  .demo-sms .ln.tag{background:none;padding:2px 0;align-self:flex-start;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--blue);font-weight:700}
  .demo-sms .ln.tag .stars{color:#f0a500;letter-spacing:2px}

  /* ---------- dark proof band — noise wash (C5) + terminal (U4) + counters ---------- */
  .dark-band{background:var(--dark);color:var(--dark-ink);position:relative;overflow:hidden}
  .dark-band .kicker{color:var(--sky)}
  .dark-band .h2 .em{color:var(--sky)}
  .dark-band .lead{color:#9aa0a8}
  .dark-band .lead b{color:var(--dark-ink)}
  #noisecnv{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2}
  @media(max-width:900px){.proof-grid{grid-template-columns:1fr;gap:40px}}
  /* real client portal, embedded + shrunk to a phone */
  .portal-embed{display:flex;flex-direction:column;align-items:center;justify-self:center}
  .pe-scale{width:448px;height:868px;transform:scale(.56);transform-origin:top center;margin:0 -88px -382px}
  .pe-scale iframe{width:448px;height:868px;border:0;display:block}
  .pe-cap{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:#5c646e;margin-top:16px;text-align:center}
  @media(max-width:900px){.pe-scale{transform:scale(.5);margin-bottom:-434px}}
  /* portal mock — mirrors the real client portal */
  .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px}
  @media(max-width:560px){.stats-row{grid-template-columns:1fr;gap:18px}}
  .dstat .n{font-family:var(--disp);font-size:clamp(2rem,3.4vw,2.8rem);font-weight:800;color:var(--sky);font-variant-numeric:tabular-nums}
  .dstat .l{font-size:12.5px;color:#9aa0a8;margin-top:5px;line-height:1.45}

  /* ---------- framework of the pain — cinematic MacBook (pin + lid-open scrub, zoom-to-pricing) ---------- */
  .mac-sec{overflow:hidden;padding-bottom:0}
  .mac-pin{min-height:100svh;display:flex;flex-direction:column;justify-content:center;position:relative}
  .mac-head{transition:opacity .3s}
  .mac-stage{
    perspective:1600px;perspective-origin:50% 30%;
    margin-top:34px;padding:0 24px;display:flex;justify-content:center;
  }
  .mbp{
    width:min(780px,94vw);transform-style:preserve-3d;position:relative;
    transform:rotateX(62deg) scale(.72) translateY(90px);will-change:transform;
  }
  .mbp,.mbp *{backface-visibility:hidden}
  /* — lid: space-black shell + bezel + display — */
  .mbp-lid{
    position:relative;transform-origin:50% 100%;transform:rotateX(-88deg);
    transform-style:preserve-3d;will-change:transform;
    aspect-ratio:16/10.4;border-radius:clamp(10px,1.8vw,18px);
    background:linear-gradient(160deg,#2a2b30 0%,#141519 38%,#0b0c0f 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.14),inset 0 -1px 0 rgba(0,0,0,.6),0 2px 4px rgba(0,0,0,.3);
    padding:clamp(7px,1.1vw,11px);
  }
  .mbp-lid::after{ /* hinge edge highlight */
    content:'';position:absolute;left:6%;right:6%;bottom:-2px;height:3px;border-radius:3px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
  }
  .mbp-display{
    position:absolute;inset:clamp(7px,1.1vw,11px);border-radius:clamp(7px,1.2vw,12px);
    background:#08090b;overflow:hidden;
  }
  .mbp-cam{
    position:absolute;top:0;left:50%;transform:translateX(-50%);z-index:6;
    width:clamp(56px,9vw,84px);height:clamp(9px,1.6vw,14px);border-radius:0 0 9px 9px;background:#08090b;
  }
  .mbp-cam::after{content:'';position:absolute;top:35%;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:#1d2530}
  .lid-glare{
    position:absolute;inset:0;z-index:5;pointer-events:none;border-radius:inherit;
    background:linear-gradient(115deg,transparent 42%,rgba(255,255,255,.075) 47%,rgba(255,255,255,.02) 55%,transparent 60%);
  }
  /* screen content — styled like the site itself */
  .pf-screen{
    position:absolute;inset:0;background:var(--paper);opacity:0;
    background-image:radial-gradient(rgba(22,24,29,.05) 1px,transparent 1px);background-size:22px 22px;
    display:flex;flex-direction:column;
  }
  .pf-bar{
    display:flex;align-items:center;gap:7px;padding:clamp(7px,1vw,11px) clamp(10px,1.6vw,16px);
    border-bottom:1px solid var(--line);background:rgba(255,255,255,.8);flex:none;
  }
  .pf-bar i{width:8px;height:8px;border-radius:50%;flex:none}
  .pf-bar i:nth-child(1){background:#e0564f}.pf-bar i:nth-child(2){background:#e0a33f}.pf-bar i:nth-child(3){background:#57b269}
  .pf-bar span{
    font-family:var(--mono);font-size:clamp(7px,1vw,10.5px);letter-spacing:.1em;color:var(--dim);
    background:#fff;border:1px solid var(--line);border-radius:7px;padding:3px 12px;margin:0 auto;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .pf-ui{position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,3vw,44px) clamp(16px,4vw,56px);color:var(--ink)}
  .pf-state{display:none;animation:pfin .45s cubic-bezier(.22,.7,.3,1)}
  .pf-state[data-active]{display:block}
  @keyframes pfin{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .pf-kick{font-family:var(--mono);font-size:clamp(8px,1.1vw,11.5px);letter-spacing:.18em;color:var(--blue);font-weight:700;margin-bottom:clamp(8px,1.4vw,16px)}
  .pf-q{font-family:var(--disp);font-weight:800;font-size:clamp(1.1rem,3.4vw,2.7rem);letter-spacing:-.03em;line-height:1.02;color:var(--ink)}
  .pf-q .stroke2{color:transparent;-webkit-text-stroke:1.5px var(--ink)}
  .pf-btns{display:flex;gap:clamp(10px,1.6vw,18px);margin-top:clamp(14px,2.6vw,30px);flex-wrap:wrap}
  .pf-btn{cursor:pointer;border:none;background:none;padding:0;outline-offset:4px;font-family:'Inter',sans-serif}
  .pf-btn .edge{border-radius:12px;background:#0f2e83;display:block}
  .pf-btn.alt .edge{background:#9aa092}
  .pf-btn .face{
    display:block;border-radius:12px;background:var(--blue);color:#fff;
    font-size:clamp(11px,1.4vw,15px);font-weight:700;padding:clamp(9px,1.5vw,14px) clamp(14px,2.2vw,24px);
    transform:translateY(-5px);transition:transform .1s;
  }
  .pf-btn.alt .face{background:#fff;color:var(--ink);border:1px solid var(--line)}
  .pf-btn:hover .face{transform:translateY(-6px)}
  .pf-btn:active .face{transform:translateY(-1px)}
  .pf-echo{font-family:var(--mono);font-size:clamp(8px,1.1vw,11px);letter-spacing:.14em;color:var(--dim);margin-bottom:clamp(8px,1.2vw,14px)}
  .pf-a{font-family:var(--disp);font-weight:800;font-size:clamp(1rem,3vw,2.35rem);letter-spacing:-.03em;line-height:1.06;color:var(--ink)}
  .pf-a em{font-style:normal;color:var(--blue)}
  .pf-sub{font-size:clamp(10px,1.3vw,14.5px);line-height:1.6;color:var(--dim);margin-top:clamp(8px,1.4vw,14px);max-width:520px}
  .pf-row{display:flex;align-items:center;gap:clamp(10px,1.8vw,18px);margin-top:clamp(12px,2.2vw,26px);flex-wrap:wrap}
  .pf-reset,.pb-reset{
    font-family:var(--mono);font-size:clamp(9px,1.1vw,11px);letter-spacing:.08em;font-weight:700;cursor:pointer;
    background:none;border:1px solid rgba(22,24,29,.25);color:var(--dim);border-radius:99px;padding:8px 15px;transition:all .2s;
  }
  .pf-reset:hover,.pb-reset:hover{color:var(--ink);border-color:var(--ink)}
  /* — base: aluminum deck, keyboard, trackpad — laid flat in 3D — */
  .mbp-base{
    position:relative;transform:rotateX(-90deg);transform-origin:50% 0%;
    height:clamp(160px,30vw,300px);border-radius:clamp(8px,1.4vw,14px);
    background:linear-gradient(180deg,#1f2024 0%,#17181c 55%,#101114 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.1),inset 0 0 0 1px rgba(0,0,0,.5);
  }
  .mbp-kbd{
    position:absolute;left:9%;right:9%;top:9%;height:52%;border-radius:8px;padding:1.2%;
    background:#0c0d10;box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);
    background-clip:padding-box;
  }
  .mbp-kbd::before{ /* key grid */
    content:'';position:absolute;inset:1.4%;border-radius:4px;
    background-image:
      repeating-linear-gradient(90deg,#191a1f 0 6.4%,#0c0d10 6.4% 7.2%),
      repeating-linear-gradient(180deg,#1a1b20 0 15.5%,#0c0d10 15.5% 18%);
    background-blend-mode:darken;opacity:.95;
  }
  .mbp-track{
    position:absolute;left:34%;right:34%;top:68%;bottom:9%;border-radius:7px;
    background:linear-gradient(180deg,#1b1c21,#141519);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);
  }
  .mbp-base::after{ /* front thumb notch */
    content:'';position:absolute;left:46%;right:46%;bottom:-1px;height:5px;border-radius:0 0 8px 8px;background:#0a0b0d;
  }
  /* — ground shadow — */
  .mbp-shadow{
    position:absolute;left:6%;right:6%;top:99%;height:clamp(90px,18vw,180px);
    transform:rotateX(-90deg);transform-origin:50% 0%;
    background:radial-gradient(50% 42% at 50% 18%,rgba(16,18,22,.34),rgba(16,18,22,.12) 55%,transparent 75%);
    filter:blur(6px);pointer-events:none;
  }
  .mac-cap{font-family:var(--mono);font-size:10.5px;color:var(--dim);letter-spacing:.14em;text-align:center;margin-top:clamp(46px,9vw,96px);opacity:0;transition:opacity .4s}
  .mac-cap.on{opacity:1}
  @media(max-width:640px){.mac-br{display:none}}
  @media(max-width:760px){
    .mbp-shadow{display:none}
    .mac-cap{margin-top:26px}
    .mac-pin{min-height:auto;padding:26px 0 8px}
  }
  /* zoom-to-pricing overlay */
  .zoomlay{
    position:fixed;inset:0;z-index:120;background:var(--paper);pointer-events:none;
    clip-path:circle(0% at 50% 50%);display:none;
  }
  .zoomlay.arm{display:block}
  /* static fallback (no GSAP / reduced motion / mobile) */
  .mbp.static{transform:rotateX(25deg) scale(.96) translateY(0);transition:transform 1s cubic-bezier(.22,.7,.3,1)}
  .mbp.static .mbp-lid{transform:rotateX(-72deg);transition:transform 1.1s cubic-bezier(.3,.65,.25,1) .15s}
  .mbp.static .pf-screen{opacity:0;transition:opacity .7s .55s}
  .mbp.static.opened .mbp-lid{transform:rotateX(-11deg)}
  .mbp.static.opened .pf-screen{opacity:1}
  .mbp.static.opened ~ * .mac-cap{opacity:1}

  /* ---------- process — numbered editorial + checkbox draw (U5) ---------- */
  .proc{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:52px}
  @media(max-width:900px){.proc{grid-template-columns:1fr}}
  .step{border-top:2px solid var(--ink);padding-top:22px}
  .step .num{font-family:var(--disp);font-size:56px;font-weight:800;color:transparent;-webkit-text-stroke:1.5px var(--ink);line-height:1}
  .step h3{font-size:19px;margin:14px 0 8px;font-family:'Inter',sans-serif;letter-spacing:0}
  .step p{font-size:14px;line-height:1.6;color:var(--dim)}
  .chk{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:13px;font-weight:600;cursor:default}
  .chk .box{
    width:22px;height:22px;border-radius:6px;border:1.5px solid var(--dim);
    display:flex;align-items:center;justify-content:center;transition:.25s;flex:none;
  }
  .chk svg{width:12px;height:12px;stroke:#fff;stroke-width:3.4;fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:22;stroke-dashoffset:22;transition:stroke-dashoffset .35s .1s}
  .chk.done .box{background:var(--blue);border-color:var(--blue);animation:chkpop .35s cubic-bezier(.34,1.56,.64,1)}
  .chk.done svg{stroke-dashoffset:0}
  @keyframes chkpop{0%{transform:scale(1)}45%{transform:scale(1.2)}100%{transform:scale(1)}}

  /* ---------- pricing — toggle (U3) + texture tiers (C7) + gradient border (U2) + folded (C3) ---------- */
  .price-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;flex-wrap:wrap}
  .tgl-row{display:flex;align-items:center;gap:14px;font-size:13.5px;font-weight:600;color:var(--dim)}
  .tgl-row .on{color:var(--ink)}
  .tgl-row .save{font-family:var(--mono);font-size:11px;color:var(--blue);font-weight:700}
  .tgl{position:relative;width:66px;height:34px;cursor:pointer;display:block}
  .tgl input{opacity:0;width:0;height:0;position:absolute}
  .tgl .track{position:absolute;inset:0;border-radius:99px;background:var(--paper2);border:1px solid var(--line);box-shadow:inset 0 2px 6px rgba(22,24,29,.12);transition:.3s}
  .tgl .thumb{
    position:absolute;top:4px;left:4px;width:26px;height:26px;border-radius:50%;background:#fff;
    box-shadow:0 2px 6px rgba(22,24,29,.25);transition:transform .35s cubic-bezier(.34,1.56,.64,1);
  }
  .tgl input:checked ~ .track{background:rgba(27,72,200,.12);border-color:rgba(27,72,200,.4)}
  .tgl input:checked ~ .thumb{transform:translateX(32px);background:var(--blue)}
  .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:52px;align-items:end}
  @media(max-width:960px){.tiers{grid-template-columns:1fr;align-items:stretch}}
  .tier{border-radius:22px;padding:32px 30px;position:relative;display:flex;flex-direction:column}
  .tier .tname{font-family:var(--mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .tier .tprice{font-family:var(--disp);font-size:44px;font-weight:800;margin-top:14px;font-variant-numeric:tabular-nums}
  .tier .tprice span{font-size:16px;font-weight:600;font-family:'Inter',sans-serif}
  .tier .tsetup{font-size:13px;margin-top:4px}
  .tier .yrline{display:none;font-size:12px;margin-top:6px;font-family:var(--mono);opacity:.75}
  .tier .yrline::after{content:attr(data-yr)}
  .tiers.ann .yrline{display:block}
  .tier ul{list-style:none;margin:24px 0 28px;flex:1}
  .tier li{font-size:14px;padding:7px 0 7px 24px;position:relative;line-height:1.5}
  .tier li::before{content:'✓';position:absolute;left:0;font-weight:800}
  .tier .tbtn{display:block;text-align:center;font-size:14px;font-weight:700;text-decoration:none;border-radius:12px;padding:14px;transition:transform .15s}
  .tier .tbtn:active{transform:scale(.97)}
  /* tier 1 — paper + folded corner */
  .tier.paper{background:#fff;border:1px solid var(--line);color:var(--ink);overflow:hidden}
  .tier.paper::before{
    content:'';position:absolute;top:0;right:0;width:52px;height:52px;
    background:linear-gradient(225deg,var(--paper2) 48%,rgba(27,72,200,.35) 50%,var(--blue) 52%,#12318f 100%);
    box-shadow:-4px 4px 10px rgba(22,24,29,.18);clip-path:polygon(0 0,100% 0,100% 100%);
    transform-origin:top right;transition:transform .45s cubic-bezier(.22,.7,.3,1),opacity .3s;
  }
  .tier.paper:hover::before{transform:scale(.1);opacity:0}
  .tier.paper .tname{color:var(--dim)}
  .tier.paper .tsetup{color:var(--dim)}
  .tier.paper li::before{color:var(--blue)}
  .tier.paper .tbtn{border:1.5px solid var(--ink);color:var(--ink)}
  .tier.paper .tbtn:hover{background:var(--ink);color:#fff}
  /* tier 2 — gradient-border highlight */
  @property --angle{syntax:'<angle>';initial-value:0deg;inherits:false}
  .tier-wrap{
    position:relative;border-radius:24px;padding:2.5px;
    background:conic-gradient(from var(--angle),rgba(27,72,200,.12) 15%,var(--blue) 42%,#7ee0ff 52%,rgba(27,72,200,.12) 78%);
    animation:spin-angle 4s linear infinite;
  }
  @keyframes spin-angle{to{--angle:360deg}}
  .tier.glass{
    background:repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 2px,transparent 2px 7px),linear-gradient(165deg,#182648,#101216 75%);
    color:#fff;border-radius:22px;padding-top:42px;padding-bottom:42px;
  }
  .tier.glass .tname{color:#8fb0ff}
  .tier.glass .tsetup{color:#8b93a5}
  .tier.glass li::before{color:var(--sky)}
  .tier.glass .pop{
    position:absolute;top:-13px;left:50%;transform:translateX(-50%);
    font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.12em;
    background:var(--blue);color:#fff;border-radius:99px;padding:6px 14px;white-space:nowrap;
  }
  .tier.glass .tbtn{background:var(--dark-ink);color:var(--dark)}
  .tier.glass .tbtn:hover{filter:brightness(1.06)}
  /* tier 3 — dark shader */
  .tier.shader{background:radial-gradient(130% 120% at 15% 0%,#15203c 0%,var(--dark) 55%);color:var(--dark-ink);border:1px solid rgba(126,168,255,.35);overflow:hidden}
  .tier.shader::after{content:'';position:absolute;inset:0;background:radial-gradient(60% 40% at 75% 110%,rgba(126,168,255,.24),transparent);animation:pulse 3.4s infinite;pointer-events:none}
  .tier.shader .tname{color:var(--sky)}
  .tier.shader .tsetup{color:#8b93a5}
  .tier.shader li::before{color:var(--sky)}
  .tier.shader .tbtn{border:1.5px solid var(--dark-ink);color:var(--dark-ink);position:relative;z-index:2}
  .tier.shader .tbtn:hover{background:var(--dark-ink);color:var(--dark)}

  /* ---------- pricing v2 — path banner + site strip + transparent tiers ---------- */
  .path-banner{
    display:none;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;
    margin-top:34px;background:var(--blue-soft);border:1.5px solid rgba(27,72,200,.35);
    border-radius:14px;padding:14px 18px;
  }
  body[data-path] .path-banner{display:flex;animation:pfin .4s cubic-bezier(.22,.7,.3,1)}
  .path-banner .pb-txt{font-size:14px;font-weight:700;color:var(--ink)}
  .path-banner .pb-txt b{color:var(--blue)}
  .pb-reset{border-color:rgba(22,24,29,.25);color:var(--dim)}
  .pb-reset:hover{color:var(--ink);border-color:var(--ink)}
  .site-strip{
    display:flex;flex-wrap:wrap;align-items:center;gap:8px 22px;margin-top:22px;
    background:#fff;border:1px dashed rgba(22,24,29,.22);border-radius:14px;padding:16px 22px;
  }
  .site-strip .sname{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--dim)}
  .site-strip .sprice{font-family:var(--disp);font-size:22px;font-weight:800;font-variant-numeric:tabular-nums}
  .site-strip .sprice span{font-size:12.5px;font-weight:600;font-family:'Inter',sans-serif;color:var(--dim)}
  .site-strip .sdesc{font-size:13px;color:var(--dim);flex:1;min-width:220px}
  .site-strip .sdesc b{color:var(--ink)}
  .site-strip a{font-family:var(--mono);font-size:11.5px;letter-spacing:.06em;color:var(--blue);text-decoration:none;white-space:nowrap;font-weight:700}
  .site-strip a:hover{text-decoration:underline}
  .tiers{align-items:stretch}
  .tier-col{display:flex;transition:opacity .45s ease,filter .45s ease,transform .45s ease}
  .tier-col>*{flex:1;display:flex}
  .tier-wrap{display:flex;width:100%}
  .tier-wrap .tier{flex:1}
  .tier li{font-size:13.5px}
  .fixtag{
    display:none;font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;
    background:var(--blue);color:#fff;border-radius:8px;padding:7px 12px;margin-bottom:16px;
    align-self:flex-start;animation:pfin .4s cubic-bezier(.22,.7,.3,1);
  }
  .tier-col.rec .fixtag{display:inline-block}
  .tier-col.rec{transform:translateY(-6px)}
  .tier-col.rec .tier{box-shadow:0 22px 54px rgba(27,72,200,.22)}
  .tier-col.dim,.site-strip.dim{opacity:.42;filter:saturate(.6)}
  .site-strip.rec{border-style:solid;border-color:rgba(27,72,200,.5);box-shadow:0 14px 36px rgba(27,72,200,.14)}
  .tier-col.rec .tier.glass .pop{display:none}
  .price-note{font-size:13px;color:var(--dim);margin-top:26px;text-align:center}
  .price-note b{color:var(--ink)}

  /* ---------- FAQ ---------- */
  .faq{max-width:720px;margin:48px auto 0}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{
    font-size:16.5px;font-weight:700;padding:20px 34px 20px 2px;cursor:pointer;list-style:none;position:relative;
  }
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+';position:absolute;right:6px;top:50%;transform:translateY(-50%);font-size:22px;font-weight:400;color:var(--blue);transition:transform .3s}
  .faq details[open] summary::after{transform:translateY(-50%) rotate(45deg)}
  .faq .a{font-size:14.5px;line-height:1.65;color:var(--dim);padding:0 2px 22px;max-width:640px}

  /* ---------- final CTA — particles (C6) + rays (V7) ---------- */
  .final{position:relative;overflow:hidden;text-align:center}
  .final .rays{
    position:absolute;inset:-50% -20%;pointer-events:none;transform-origin:50% 0;
    background:conic-gradient(from 180deg at 50% 0%,
      transparent 0deg,rgba(126,168,255,.07) 10deg,transparent 20deg,
      transparent 55deg,rgba(126,168,255,.11) 65deg,transparent 75deg,
      transparent 115deg,rgba(126,168,255,.08) 125deg,transparent 135deg,
      transparent 170deg,rgba(126,168,255,.1) 180deg,transparent 190deg,transparent 360deg);
    animation:raybreathe 12s ease-in-out infinite alternate;
  }
  @keyframes raybreathe{from{transform:rotate(-4deg)}to{transform:rotate(4deg) scale(1.05)}}
  #ctacnv{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .final .inner{position:relative;z-index:2}
  .final .h2{font-size:clamp(2.2rem,5.4vw,4.2rem)}
  .final .lead{margin:0 auto}
  .final .push{margin-top:38px}
  .final .sub-cta{margin-top:20px;font-size:13.5px;color:#9aa0a8}
  .final .sub-cta a{color:var(--sky);text-decoration:none;font-weight:600}

  footer{background:var(--dark);color:#7a8088;border-top:1px solid var(--dark-line);padding:34px 0;font-size:12.5px}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
  footer b{color:var(--dark-ink);font-family:var(--disp)}
  footer b i{font-style:normal;color:var(--sky)}

  /* sticky mobile call bar */
  .callbar{
    position:fixed;left:12px;right:12px;bottom:12px;z-index:80;display:none;
    background:var(--ink);color:#fff;border-radius:16px;padding:14px 18px;
    font-weight:700;font-size:14.5px;text-align:center;text-decoration:none;
    box-shadow:0 10px 34px rgba(22,24,29,.35);
    transform:translateY(120%);transition:transform .4s cubic-bezier(.22,.7,.3,1);
  }
  .callbar.show{transform:none}
  @media(max-width:760px){.callbar{display:block}}

  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
    .rv,.svc{opacity:1;transform:none}
    .line-mask>span{transform:none}
    .wcard .img .fill{clip-path:inset(0 0 0 0)}
  }

  /* ============ GRAFTED LUXURY SECTIONS (namespaced lx-) ============ */
  .lx-what .eyebrow,.lx-portal .eyebrow{
    font-size:.74rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase;
    color:var(--blue);margin-bottom:24px;display:flex;align-items:center;gap:14px;
  }
  .lx-what .eyebrow::before,.lx-portal .eyebrow::before{content:"";width:26px;height:1px;background:var(--blue);opacity:.55;flex:none}
  .lx-portal .lede{color:var(--dim);max-width:34em;margin-top:20px;font-size:1.05rem;line-height:1.6}
  .lx-portal .lede b{color:var(--ink);font-weight:700}

  /* leak, added up: dark dramatic beat, animated count-up */
  .lx-leak{background:var(--dark);color:var(--dark-ink);text-align:center;position:relative;overflow:hidden}
  .lx-leak .wrap{position:relative;z-index:2}
  .lx-leak .lx-eye{font-family:var(--mono);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--sky);margin-bottom:30px;display:inline-block}
  .lx-leak .leak-line{
    font-family:var(--disp);font-weight:700;letter-spacing:-.022em;line-height:1.16;
    font-size:clamp(1.8rem,4.6vw,3.5rem);max-width:20em;margin-inline:auto;
  }
  .lx-leak .leak-line .big{color:var(--sky);font-variant-numeric:tabular-nums;white-space:nowrap}
  .lx-leak .leak-line .ah{color:#fff;box-shadow:inset 0 -.14em 0 rgba(27,72,200,.9)}
  .lx-leak .leak-note{color:#8b93a5;font-size:.9rem;margin-top:32px}

  /* what we build: Luxury splits with live demos */
  .lx-what .split{
    display:grid;grid-template-columns:1fr 1fr;gap:clamp(48px,6vw,104px);
    align-items:center;margin-top:clamp(72px,8vw,120px);
  }
  .lx-what .split:first-of-type{margin-top:clamp(48px,5vw,80px)}
  .lx-what .lx-step{
    font-family:var(--disp);font-weight:800;color:var(--blue);font-size:.92rem;
    letter-spacing:.08em;display:block;margin-bottom:16px;font-variant-numeric:tabular-nums;border:0;padding:0;
  }
  .lx-what .split-txt h3{font-family:var(--disp);font-weight:700;letter-spacing:-.02em;line-height:1.08;font-size:clamp(1.55rem,3vw,2.3rem);max-width:12em}
  .lx-what .split-txt p{color:var(--dim);margin-top:18px;max-width:30em;line-height:1.65}
  .lx-what .lx-chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .lx-what .lx-chip{
    font-size:.82rem;font-weight:600;color:var(--ink);
    border:1px solid var(--line);border-radius:999px;padding:8px 16px;background:var(--paper2);
  }
  .lx-what .frame{
    border-radius:18px;overflow:hidden;position:relative;
    box-shadow:0 1px 2px rgba(22,24,29,.05),0 26px 66px rgba(22,24,29,.12);
    aspect-ratio:4/3.4;background:#0c0e12;
  }
  .lx-what .frame .fbg{position:absolute;inset:0}
  .lx-what .frame .cap{
    position:absolute;left:14px;bottom:14px;z-index:3;
    background:rgba(255,255,255,.92);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    border-radius:999px;padding:7px 15px;font-size:.76rem;font-weight:700;color:var(--ink);
  }
  .lx-what .split.flip .split-txt{order:2}
  .lx-what .split.flip .frame{order:1}
  @media (max-width:900px){
    .lx-what .split,.lx-what .split.flip{grid-template-columns:1fr;gap:38px}
    .lx-what .split.flip .split-txt{order:1}
    .lx-what .split.flip .frame{order:2}
  }

  /* portal: Luxury compact split, live */
  .lx-portal{background:var(--paper2)}
  .lx-portal .portal-split{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(40px,6vw,84px);align-items:center}
  .lx-portal .portal-split>div{min-width:0}
  .lx-portal .plist{list-style:none;margin-top:28px;border-top:1px solid var(--line)}
  .lx-portal .plist li{padding:16px 0;border-bottom:1px solid var(--line)}
  .lx-portal .plist li:last-child{border-bottom:0}
  .lx-portal .plist b{display:block;font-weight:700;font-size:1rem;letter-spacing:-.01em;color:var(--ink)}
  .lx-portal .plist span{display:block;color:var(--dim);font-size:.92rem;margin-top:4px;line-height:1.55}
  .lx-portal .device{
    width:min(300px,100%);height:600px;margin:0 auto;border-radius:38px;overflow:hidden;background:#101216;
    box-shadow:0 30px 70px rgba(22,24,29,.2),0 0 0 8px #101216,0 0 0 10px rgba(22,24,29,.5);
  }
  .lx-portal .device iframe{width:100%;height:100%;border:0;display:block;background:#fff}
  .lx-portal .device-note{text-align:center;color:var(--dim);font-size:.84rem;margin-top:16px}
  @media (max-width:900px){.lx-portal .portal-split{grid-template-columns:1fr;gap:48px}}
</style>
</head>
