<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>15 new jobs in 60 days, or you don't pay · RecoverRevenue</title>
<meta name="description" content="We answer the calls you miss, text them back in 60 seconds, and re-book the customers already in your records. 15 new jobs in 60 days or you are never charged.">
<link rel="canonical" href="https://recoverrevenue.co/start">
<meta property="og:title" content="15 new jobs in 60 days, or you don't pay.">
<meta property="og:description" content="Missed-call text-back, past-customer reactivation, and an AI receptionist for local service businesses. First charge is day 61, and only if you got the jobs.">
<meta property="og:url" content="https://recoverrevenue.co/start">
<meta property="og:type" content="website">
<meta name="robots" content="index,follow">
<link rel="icon" type="image/svg+xml" href="../assets/logo-mark.svg">
<link rel="apple-touch-icon" sizes="180x180" href="../assets/apple-touch-icon.png">
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
<link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   RecoverRevenue · /start
   The single destination every channel points at. One offer,
   one action: book the 15 minutes. Design tokens are lifted
   verbatim from index.html so the two pages are one site.
   ============================================================ */
:root{
  --paper:#f4f7fc;
  --surface:#fdfdff;
  --ink:#0e1726;
  --muted:#5c6a80;
  --accent:#17419b;
  --accent-deep:#102e70;
  --accent-light:rgba(23,65,155,.07);
  --line:rgba(14,23,38,.09);
  --line-soft:rgba(14,23,38,.055);
  --r:18px;
  --e:cubic-bezier(.22,.61,.25,1);
  --eo:cubic-bezier(.2,.72,.2,1.04);
  --pos:#12b866;
  --warn:#c2410c;
  --display:'Cabinet Grotesk','Helvetica Neue',Helvetica,Arial,sans-serif;
  --body:'Satoshi','Helvetica Neue',Helvetica,Arial,sans-serif;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
[id]{scroll-margin-top:88px}
body{font-family:var(--body);background:var(--paper);color:var(--ink);
  line-height:1.7;font-size:1.0625rem;-webkit-font-smoothing:antialiased;overflow-x:clip}
::selection{background:rgba(23,65,155,.14)}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer;background:none;border:0;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.022em;line-height:1.08}
.num{font-variant-numeric:tabular-nums}
.wrap{width:min(1180px,calc(100% - 44px));margin-inline:auto}

/* reveal */
html.js .rv{opacity:0;transform:translateY(26px);
  transition:opacity .56s var(--e) var(--d,0s),transform .68s var(--eo) var(--d,0s)}
html.js .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  html.js .rv{transform:none;transition:opacity .4s ease}
}

/* ---------- header: wordmark only. No nav. No way out but the calendar. ---------- */
.nav{position:sticky;top:0;z-index:50;background:rgba(244,247,252,.86);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  box-shadow:0 1px 0 var(--line-soft)}
.nav-in{display:flex;align-items:center;justify-content:space-between;
  padding-block:16px;gap:16px}
.logo{font-family:var(--display);font-weight:800;font-size:1.1rem;letter-spacing:-.02em}
.logo b{color:var(--accent)}
.nav-note{font-size:.83rem;color:var(--muted);font-weight:500}
.nav-note b{color:var(--ink);font-weight:700}
@media (max-width:620px){.nav-note{display:none}}

/* ---------- hero ---------- */
.hero{padding:clamp(52px,7vw,92px) 0 clamp(30px,4vw,44px)}
.eyebrow{font-size:.74rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase;
  color:var(--accent);margin-bottom:24px;display:flex;align-items:center;gap:13px}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--accent);opacity:.55;flex:none}
.hero h1{font-size:clamp(2.5rem,6.1vw,4.6rem);font-weight:800;line-height:1.03;max-width:14em}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero-sub{color:var(--muted);font-size:clamp(1.04rem,1.5vw,1.2rem);max-width:40em;
  margin-top:28px;line-height:1.78}
.hero-sub b{color:var(--ink);font-weight:700}

/* ---------- the split: proof rail + calendar ---------- */
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.02fr);
  gap:clamp(28px,3.4vw,54px);align-items:start;padding-bottom:clamp(70px,9vw,120px)}

/* calendar column, sticky on desktop */
.book{position:sticky;top:88px}
.book-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);
  overflow:hidden;box-shadow:0 24px 60px -34px rgba(14,23,38,.3)}
.book-head{padding:22px 26px 18px;border-bottom:1px solid var(--line-soft);
  display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.book-head h2{font-size:1.16rem;letter-spacing:-.015em}
.book-head p{font-size:.88rem;color:var(--muted);margin-top:5px;line-height:1.6}
.live{display:inline-flex;align-items:center;gap:7px;font-size:.72rem;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;color:var(--pos);
  background:rgba(18,184,102,.09);padding:5px 11px;border-radius:999px;flex:none;white-space:nowrap}
.live i{width:6px;height:6px;border-radius:50%;background:var(--pos);display:block;
  animation:pulse 2.2s var(--e) infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.82)}}
.cal-slot{min-height:660px;background:var(--surface)}
@media (max-width:1040px){.cal-slot{min-height:640px}}
.cal-fallback{padding:34px 26px;text-align:center}
.cal-fallback p{color:var(--muted);font-size:.93rem;margin-bottom:18px}
.btn{display:inline-flex;align-items:center;gap:11px;font-weight:700;font-size:1rem;
  border-radius:999px;padding:17px 32px;
  transition:background .38s var(--e),border-color .38s var(--e),transform .38s var(--e)}
.btn-primary{background:var(--accent);color:var(--paper)}
.btn-primary:hover{background:var(--accent-deep);transform:translateY(-1px)}
.btn-primary .arr{transition:transform .45s var(--e)}
.btn-primary:hover .arr{transform:translateX(4px)}
.book-foot{padding:16px 26px;border-top:1px solid var(--line-soft);
  font-size:.85rem;color:var(--muted);display:flex;gap:9px;align-items:flex-start}
.book-foot svg{flex:none;margin-top:3px}

/* rail cards */
.rail{display:flex;flex-direction:column;gap:20px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:28px 28px 26px}
.card h2{font-size:1.1rem;letter-spacing:-.015em;margin-bottom:16px}
.card h2.warnh{color:var(--warn)}

/* the 15-minute agenda */
.agenda{list-style:none;display:flex;flex-direction:column;gap:16px;counter-reset:a}
.agenda li{display:flex;gap:14px;font-size:.95rem;line-height:1.62;counter-increment:a}
.agenda li::before{content:counter(a);flex:none;width:24px;height:24px;border-radius:50%;
  background:var(--accent-light);color:var(--accent);font-family:var(--display);font-weight:800;
  font-size:.78rem;display:grid;place-items:center;margin-top:2px}
.agenda b{font-weight:700}

/* the anchor calculator */
.calc{background:var(--ink);color:#fff;border-radius:var(--r);padding:28px 28px 26px;
  border:1px solid var(--ink)}
.calc h2{font-size:1.1rem;color:#fff;margin-bottom:6px}
.calc .sub{font-size:.87rem;color:#a3b2ca;margin-bottom:22px;line-height:1.6}
.calc-row{display:flex;align-items:baseline;justify-content:space-between;
  gap:12px;margin-bottom:10px}
.calc-row label{font-size:.78rem;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;color:#a3b2ca}
.calc-row .v{font-family:var(--display);font-weight:800;font-size:1.05rem;
  font-variant-numeric:tabular-nums}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:3px;
  background:rgba(255,255,255,.18);border-radius:3px;outline:none;margin:8px 0 26px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
  width:20px;height:20px;border-radius:50%;background:#fff;cursor:pointer;
  box-shadow:0 2px 8px rgba(0,0,0,.4)}
input[type=range]::-moz-range-thumb{width:20px;height:20px;border:0;border-radius:50%;
  background:#fff;cursor:pointer}
.calc-out{border-top:1px solid rgba(244,247,252,.16);padding-top:20px;
  display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap}
.calc-out .lbl{font-size:.78rem;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;color:#a3b2ca;max-width:13em;line-height:1.5}
.calc-out .amt{font-family:var(--display);font-weight:800;font-size:clamp(1.9rem,4vw,2.5rem);
  letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1}
.calc-note{font-size:.8rem;color:#a3b2ca;margin-top:16px;line-height:1.6}

/* who it is not for */
.nots{list-style:none;display:flex;flex-direction:column;gap:13px}
.nots li{display:flex;gap:12px;font-size:.95rem;line-height:1.62;color:var(--muted)}
.nots li i{flex:none;width:17px;height:17px;border-radius:50%;border:1.5px solid var(--warn);
  margin-top:4px;position:relative}
.nots li i::before,.nots li i::after{content:"";position:absolute;left:3px;top:6.5px;
  width:8px;height:1.5px;background:var(--warn)}
.nots li i::before{transform:rotate(45deg)}
.nots li i::after{transform:rotate(-45deg)}
.nots b{color:var(--ink);font-weight:700}

/* ---------- the delivery path ---------- */
.band{background:var(--surface);border-block:1px solid var(--line-soft);
  padding-block:clamp(72px,9vw,116px)}
.band-head h2{font-size:clamp(1.85rem,4.1vw,2.85rem);max-width:16em}
.band-head .lede{color:var(--muted);max-width:38em;margin-top:20px;font-size:1.07rem}
.band-head .lede b{color:var(--ink);font-weight:700}
.path{margin-top:48px;border:1px solid var(--line);border-radius:var(--r);
  overflow:hidden;background:var(--paper)}
.path-row{display:grid;grid-template-columns:160px minmax(0,1fr) minmax(0,1.15fr);
  gap:22px;padding:20px 26px;border-bottom:1px solid var(--line-soft);align-items:start}
.path-row:last-child{border-bottom:0}
.path-row.hd{background:var(--surface);font-size:.73rem;font-weight:700;letter-spacing:.13em;
  text-transform:uppercase;color:var(--muted)}
.path-when{font-family:var(--display);font-weight:800;font-size:.93rem;
  font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.path-row.key .path-when{color:var(--accent)}
.path-what{font-weight:700;font-size:.97rem;line-height:1.5}
.path-why{color:var(--muted);font-size:.92rem;line-height:1.6}
@media (max-width:760px){
  .path-row,.path-row.hd{grid-template-columns:1fr;gap:6px;padding:18px 20px}
  .path-row.hd{display:none}
  .path-when{color:var(--accent);font-size:.76rem;letter-spacing:.11em;text-transform:uppercase}
}
.math{margin-top:34px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.math-cell{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px 24px}
.math-cell .n{font-family:var(--display);font-weight:800;font-size:1.85rem;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;color:var(--accent)}
.math-cell .t{font-size:.93rem;color:var(--muted);margin-top:8px;line-height:1.6}
.math-cell .t b{color:var(--ink);font-weight:700}

/* ---------- price + objections ---------- */
.close{padding-block:clamp(72px,9vw,116px)}
.price-card{background:var(--ink);color:#fff;border-radius:22px;
  padding:clamp(32px,4.4vw,54px);display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,.86fr);gap:clamp(26px,3.4vw,54px);align-items:center}
.price-card h2{color:#fff;font-size:clamp(1.75rem,3.7vw,2.5rem);max-width:12em}
.price-card .pl{color:#a3b2ca;margin-top:18px;font-size:1.03rem;line-height:1.78;max-width:32em}
.price-card .pl b{color:#fff;font-weight:700}
.price-box{background:rgba(244,247,252,.06);border:1px solid rgba(244,247,252,.16);
  border-radius:16px;padding:28px 30px}
.price-amt{font-family:var(--display);font-weight:800;font-size:2.9rem;letter-spacing:-.035em;
  font-variant-numeric:tabular-nums;line-height:1}
.price-amt small{font-size:1rem;font-weight:500;color:#a3b2ca;letter-spacing:0}
.price-list{list-style:none;margin-top:22px;display:flex;flex-direction:column;gap:11px}
.price-list li{display:flex;gap:11px;font-size:.94rem;color:#dbe3f0;line-height:1.55}
.price-list li i{flex:none;width:16px;height:16px;border-radius:50%;background:var(--pos);
  margin-top:4px;position:relative}
.price-list li i::after{content:"";position:absolute;left:5.2px;top:3px;width:4px;height:8px;
  border:solid var(--ink);border-width:0 2px 2px 0;transform:rotate(43deg)}
.price-list b{color:#fff;font-weight:700}
@media (max-width:900px){.price-card{grid-template-columns:1fr}}

.qa{margin-top:clamp(48px,6vw,76px);display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
@media (max-width:820px){.qa{grid-template-columns:1fr}}
.qa-item{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:28px}
.qa-item h3{font-size:1.02rem;margin-bottom:11px;letter-spacing:-.012em}
.qa-item p{color:var(--muted);font-size:.95rem;line-height:1.72}
.qa-item p b{color:var(--ink);font-weight:700}

.tail{text-align:center;margin-top:clamp(52px,6vw,80px)}
.tail h2{font-size:clamp(1.7rem,3.6vw,2.4rem);max-width:16em;margin-inline:auto}
.tail p{color:var(--muted);margin-top:16px;max-width:32em;margin-inline:auto}
.tail .btn{margin-top:28px}
.tail-alt{font-size:.9rem;color:var(--muted);margin-top:22px}
.tail-alt a{color:var(--accent);font-weight:700;border-bottom:1px solid rgba(23,65,155,.3)}
.tail-alt a:hover{border-bottom-color:var(--accent)}

footer{border-top:1px solid var(--line-soft);padding-block:30px;background:var(--surface)}
.foot{display:flex;flex-wrap:wrap;gap:14px 26px;align-items:center;justify-content:space-between;
  font-size:.85rem;color:var(--muted)}
.foot a:hover{color:var(--ink)}

/* mobile: calendar first, everything else under it */
@media (max-width:980px){
  .split{grid-template-columns:1fr;gap:24px}
  .book{position:static;order:-1}
}

/* sticky mobile CTA bar */
.mbar{position:fixed;left:0;right:0;bottom:0;z-index:60;display:none;
  padding:12px 16px calc(12px + env(safe-area-inset-bottom));
  background:rgba(244,247,252,.94);backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);box-shadow:0 -1px 0 var(--line)}
.mbar .btn{width:100%;justify-content:center;padding:16px 24px}
@media (max-width:980px){
  .mbar.on{display:block}
  body{padding-bottom:0}
}
</style>
<script src="../assets/pixel.js"></script>
</head>
<body>

<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="https://recoverrevenue.co/">Recover<b>Revenue</b></a>
    <span class="nav-note">Local service businesses &middot; <b>15 jobs in 60 days or you don't pay</b></span>
  </div>
</header>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="wrap">
    <p class="eyebrow rv">For owner-operators with 200+ past customers</p>
    <h1 class="rv" style="--d:.06s">15 new jobs in 60 days, <em>or you don't pay.</em></h1>
    <p class="hero-sub rv" style="--d:.14s">We answer the calls you miss, text every one of them back inside 60 seconds, and re-book the customers already sitting in your records. You put a card on file the day we start. <b>We do not charge it until day 61, and only if you got the 15 jobs.</b></p>
  </div>
</section>

<!-- ================= SPLIT: PROOF + CALENDAR ================= -->
<div class="wrap split">

  <!-- calendar -->
  <div class="book">
    <div class="book-card rv">
      <div class="book-head">
        <div>
          <h2>Pick a time. 15 minutes, on the phone.</h2>
          <p>No slide deck, no screen share, no second meeting to get a number.</p>
        </div>
        <span class="live"><i></i>Booking</span>
      </div>
      <div class="cal-slot" id="calSlot">
        <div class="cal-fallback" id="calFallback">
          <p>Loading the calendar. If it does not appear, the direct link below works the same way.</p>
          <a class="btn btn-primary" id="calDirect" href="https://calendly.com/chase-sza/15min" target="_blank" rel="noopener">Open the calendar <span class="arr">&rarr;</span></a>
        </div>
      </div>
      <div class="book-foot">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5 2.5 4v4c0 3.2 2.3 5.8 5.5 6.5 3.2-.7 5.5-3.3 5.5-6.5V4L8 1.5Z" stroke="#5c6a80" stroke-width="1.3" stroke-linejoin="round"/></svg>
        <span>You are booking a phone call, not a payment. Nothing is charged on this page.</span>
      </div>
    </div>
  </div>

  <!-- proof rail -->
  <div class="rail">

    <div class="card rv" style="--d:.05s">
      <h2>What the 15 minutes actually is</h2>
      <ol class="agenda">
        <li><span>You tell me what an average job is worth to you and roughly how many calls a week go unanswered.</span></li>
        <li><span>I tell you what that costs you a year, and whether your past-customer list is long enough to carry the guarantee.</span></li>
        <li><span><b>If it is a fit, we start that week. If it is not, I say so on the call</b>, not in a follow-up sequence three days later.</span></li>
      </ol>
    </div>

    <div class="calc rv" style="--d:.1s">
      <h2>What 15 jobs is worth to you</h2>
      <p class="sub">Move the slider to what you charge for an average job.</p>
      <div class="calc-row">
        <label for="ticket">Average job value</label>
        <span class="v" id="ticketVal">$800</span>
      </div>
      <input type="range" id="ticket" min="150" max="5000" step="50" value="800"
             aria-label="Average job value in dollars">
      <div class="calc-out">
        <span class="lbl">15 jobs at that ticket</span>
        <span class="amt" id="jobsVal">$12,000</span>
      </div>
      <p class="calc-note" id="calcNote">That is what the guarantee is worth to you before you are charged a dollar. Sixty days of the system costs you nothing until it clears that bar.</p>
    </div>

    <div class="card rv" style="--d:.15s">
      <h2 class="warnh">Do not book if any of these are true</h2>
      <ul class="nots">
        <li><i></i><span><b>You have fewer than 200 past customers with phone numbers.</b> Re-booking your own customers is the fastest lever we have. Without the list the 15 jobs are not honest to promise, and I will not promise them.</span></li>
        <li><i></i><span><b>You do not want your past customers texted.</b> That is the engine. If it is off, so is the guarantee.</span></li>
        <li><i></i><span><b>You are looking for someone to run ads.</b> We do not buy your traffic. We catch the traffic you already paid for and lose.</span></li>
        <li><i></i><span><b>You want to think about it for a quarter.</b> I onboard two or three businesses a month. The calendar is the whole commitment device.</span></li>
      </ul>
    </div>

  </div>
</div>

<!-- ================= WHERE THE 15 JOBS COME FROM ================= -->
<section class="band">
  <div class="wrap">
    <div class="band-head">
      <p class="eyebrow rv">The delivery path</p>
      <h2 class="rv" style="--d:.06s">A guarantee without a plan behind it is a wish.</h2>
      <p class="lede rv" style="--d:.12s">Here is the whole 60 days, in order, and the reason each step sits where it does. <b>The clock starts when the phone carriers approve your text campaign</b>, not the day you sign, because nothing outbound can legally send before that.</p>
    </div>

    <div class="path rv" style="--d:.08s">
      <div class="path-row hd"><span>When</span><span>What happens</span><span>Why it is in that order</span></div>
      <div class="path-row">
        <span class="path-when">Day 1 to 3</span>
        <span class="path-what">Export your customer list. File your carrier registration.</span>
        <span class="path-why">Everything outbound waits on carrier approval, so it is filed on the first day, not the first week.</span>
      </div>
      <div class="path-row">
        <span class="path-when">Day 1 to 7</span>
        <span class="path-what">Booking site live. Google Business Profile claimed and rebuilt.</span>
        <span class="path-why">The inbound floor. It runs while the carriers are still reviewing.</span>
      </div>
      <div class="path-row">
        <span class="path-when">Day 4 to 10</span>
        <span class="path-what">Missed-call text-back live on your existing number.</span>
        <span class="path-why">Catches the calls you are losing today. This one needs no approval from anybody.</span>
      </div>
      <div class="path-row key">
        <span class="path-when">Carrier approval</span>
        <span class="path-what">Reactivation campaign one, to your entire past-customer list.</span>
        <span class="path-why">The fastest jobs in the plan. A customer who already paid you converts far above a stranger.</span>
      </div>
      <div class="path-row">
        <span class="path-when">Two weeks later</span>
        <span class="path-what">Reactivation two, to everyone who did not answer, different angle.</span>
        <span class="path-why">The second send routinely books close to what the first one did.</span>
      </div>
      <div class="path-row">
        <span class="path-when">Throughout</span>
        <span class="path-what">Every new inquiry answered by text in 60 seconds. Review requests after each job.</span>
        <span class="path-why">Turns the inbound floor into a rising one instead of a fixed one.</span>
      </div>
    </div>

    <div class="math">
      <div class="math-cell rv">
        <div class="n num">10</div>
        <p class="t">jobs from a <b>200-person list</b> at a 5% re-book rate. A longer list clears the whole guarantee on this line alone.</p>
      </div>
      <div class="math-cell rv" style="--d:.06s">
        <div class="n num">24</div>
        <p class="t">jobs from missed-call capture, for a business missing <b>8 calls a week</b> at a 25% recovery rate, over 60 days.</p>
      </div>
      <div class="math-cell rv" style="--d:.12s">
        <div class="n num">15</div>
        <p class="t">is the number we guarantee. <b>The two lines above clear it with room</b>, which is the only reason it is sayable out loud.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= PRICE + OBJECTIONS ================= -->
<section class="close">
  <div class="wrap">

    <div class="price-card rv">
      <div>
        <h2>The price is public, and you do not pay it first.</h2>
        <p class="pl">Most agencies quote you after a discovery call and a proposal. Here is the number now, so the call is about whether it works, not what it costs. <b>Your card goes on file the day we start and is charged for the first time on day 61.</b></p>
      </div>
      <div class="price-box">
        <div class="price-amt num">$1,497<small> /month</small></div>
        <ul class="price-list">
          <li><i></i><span><b>$0 setup.</b> The build is included.</span></li>
          <li><i></i><span><b>$0 for the first 60 days</b>, always.</span></li>
          <li><i></i><span>Day 61: charged only if the system booked <b>15 or more jobs</b>.</span></li>
          <li><i></i><span>Miss it and you are never charged, we part ways, <b>and the website is yours</b>.</span></li>
          <li><i></i><span>Hit it and you continue on a six-month term.</span></li>
        </ul>
      </div>
    </div>

    <div class="qa">
      <div class="qa-item rv">
        <h3>What if you miss the 15?</h3>
        <p>You are not charged. Not a reduced fee, not a credit toward next month. <b>Zero.</b> The agreement ends, you keep the website and the Google profile we rebuilt, and I have spent two months working for free. That is the deal, and it is written that way in the agreement.</p>
      </div>
      <div class="qa-item rv" style="--d:.05s">
        <h3>What is the catch?</h3>
        <p>Two, and both are on this page already. <b>The 60 days start at carrier approval</b>, usually a few days after we file, because no text can legally send before it. And <b>you need 200 past customers with phone numbers</b>. Without that list I am guessing, and I will not guarantee a guess.</p>
      </div>
      <div class="qa-item rv" style="--d:.1s">
        <h3>Why would anyone offer this?</h3>
        <p>Because I am new and I have no case studies to show you. <b>A guarantee is the only honest substitute for a track record.</b> It puts the risk on me, which is where it belongs until I have earned otherwise. When I have a wall of results, this offer goes away.</p>
      </div>
      <div class="qa-item rv" style="--d:.15s">
        <h3>What counts as a job?</h3>
        <p>A booked appointment that the system produced and timestamped: a missed call it recovered, a past customer it re-booked, or an inquiry it answered first. <b>You see every one of them in your own dashboard as it happens</b>, so on day 60 there is a log, not an argument.</p>
      </div>
    </div>

    <div class="tail rv">
      <h2>Fifteen minutes tells you whether this works for your business.</h2>
      <p>If the list is not there or the numbers do not clear, you will hear that on the call and keep your afternoon.</p>
      <a class="btn btn-primary" href="#top" id="tailCta">Pick a time <span class="arr">&rarr;</span></a>
      <p class="tail-alt">Not ready to talk? <a href="../book.html">Get the written leak audit instead</a> &mdash; it lands in your inbox and nobody calls you about it.</p>
    </div>

  </div>
</section>

<footer>
  <div class="wrap foot">
    <span class="logo">Recover<b>Revenue</b></span>
    <span>Missed-call recovery and AI phone systems for local service businesses.</span>
    <span><a href="../privacy.html">Privacy</a> &middot; <a href="../terms.html">SMS Terms</a> &middot; &copy; 2026</span>
  </div>
</footer>

<div class="mbar" id="mbar">
  <a class="btn btn-primary" href="#top">Pick a time <span class="arr">&rarr;</span></a>
</div>

<script>
document.documentElement.className += " js";
(function(){
  "use strict";

  /* ---------- reveal ---------- */
  var rvs = [].slice.call(document.querySelectorAll(".rv"));
  if(!("IntersectionObserver" in window)){
    rvs.forEach(function(e){ e.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add("in"); io.unobserve(x.target); } });
    }, { threshold:.12, rootMargin:"0px 0px -8% 0px" });
    rvs.forEach(function(e){ io.observe(e); });
  }

  /* ---------- anchor calculator ---------- */
  var t = document.getElementById("ticket"),
      tv = document.getElementById("ticketVal"),
      jv = document.getElementById("jobsVal"),
      note = document.getElementById("calcNote");
  function money(n){ return "$" + n.toLocaleString("en-US"); }
  function calc(){
    var v = +t.value, total = v * 15;
    tv.textContent = money(v);
    jv.textContent = money(total);
    /* 1497 x 2 is what the first two months would have cost at list price. */
    var ratio = Math.round(total / 2994);
    note.textContent = ratio >= 2
      ? "That is " + ratio + " times what the first two months bill at, and you are not billed for them unless we get there."
      : "Sixty days of the system costs you nothing until it clears that bar.";
  }
  t.addEventListener("input", calc);
  calc();

  /* ---------- Calendly, with the channel that sent them attached ---------- */
  var q = new URLSearchParams(window.location.search);
  function utm(k, d){ return (q.get(k) || d); }
  var src = utm("utm_source", "direct"),
      med = utm("utm_medium", "start"),
      cmp = utm("utm_campaign", "60day-guarantee"),
      cnt = utm("utm_content", "");

  var calUrl = "https://calendly.com/chase-sza/15min"
    + "?hide_gdpr_banner=1&primary_color=17419b&background_color=fdfdff&text_color=0e1726"
    + "&utm_source=" + encodeURIComponent(src)
    + "&utm_medium=" + encodeURIComponent(med)
    + "&utm_campaign=" + encodeURIComponent(cmp)
    + (cnt ? "&utm_content=" + encodeURIComponent(cnt) : "");

  var direct = document.getElementById("calDirect");
  if(direct) direct.href = calUrl;

  /* Load the inline widget. If Calendly is blocked or slow the fallback
     button is already on screen and goes to the same place. */
  var slot = document.getElementById("calSlot");
  var w = document.createElement("div");
  w.className = "calendly-inline-widget";
  w.setAttribute("data-url", calUrl);
  w.style.minWidth = "300px";
  w.style.height = "660px";
  w.setAttribute("data-auto-load", "false");

  var s = document.createElement("script");
  s.src = "https://assets.calendly.com/assets/external/widget.js";
  s.async = true;
  s.onload = function(){
    if(!window.Calendly) return;
    var fb = document.getElementById("calFallback");
    if(fb) fb.style.display = "none";
    slot.appendChild(w);
    window.Calendly.initInlineWidget({ url: calUrl, parentElement: w });
  };
  document.head.appendChild(s);

  /* ---------- mobile bar: show once the calendar has scrolled past ---------- */
  var bar = document.getElementById("mbar"), card = document.querySelector(".book-card");
  if(bar && card && "IntersectionObserver" in window){
    var bio = new IntersectionObserver(function(en){
      en.forEach(function(x){ bar.classList.toggle("on", !x.isIntersecting); });
    }, { threshold:0 });
    bio.observe(card);
  }

  /* ---------- both bottom CTAs scroll to the calendar ---------- */
  [].slice.call(document.querySelectorAll('a[href="#top"]')).forEach(function(a){
    a.addEventListener("click", function(e){
      e.preventDefault();
      card.scrollIntoView({ behavior:"smooth", block:"start" });
    });
  });
})();
</script>
</body>
</html>
